---
// Animated fractal hero banner. Each page gets a family (by part/topic) and a
// per-slug seed, so no two pages run the same animation.
interface Props {
  type: 'koch' | 'chaos' | 'sierpinski' | 'grove' | 'loops' | 'ferns' | 'spirals' | 'rings' | 'tide';
  seed: string;
  color?: string;
  height?: number;
}
const { type, seed, color = 'var(--accent)', height = 170 } = Astro.props;
---
<div class="hero-fractal" style={`color: ${color}; height: ${height}px;`} aria-hidden="true">
  <canvas data-type={type} data-seed={seed}></canvas>
</div>

<style>
  .hero-fractal {
    width: 100%;
    margin-bottom: 1.6rem;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg2);
    -webkit-mask-image: linear-gradient(to bottom, black 78%, rgba(0,0,0,0.55));
    mask-image: linear-gradient(to bottom, black 78%, rgba(0,0,0,0.55));
  }
  .hero-fractal canvas { display: block; width: 100%; height: 100%; }
</style>

<script>
  type Rng = () => number;
  function mulberry32(seed: number): Rng {
    let a = seed >>> 0;
    return () => {
      a |= 0; a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function hashSeed(s: string): number {
    let h = 2166136261;
    for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }
    return h >>> 0;
  }

  interface Anim {
    // advance one frame; dt in seconds, t = elapsed seconds
    frame(dt: number, t: number): void;
  }
  type Maker = (ctx: CanvasRenderingContext2D, W: number, H: number, rng: Rng, ink: string, bg: string) => Anim;

  const TAU = Math.PI * 2;

  function fadeRect(ctx: CanvasRenderingContext2D, W: number, H: number, bg: string, alpha: number) {
    ctx.globalAlpha = alpha;
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, W, H);
    ctx.globalAlpha = 1;
  }

  // ---- koch: a line refining itself, iteration by iteration ----
  const koch: Maker = (ctx, W, H, rng, ink, bg) => {
    const maxLevel = 5;
    // vertical squash so the first (largest) bump still fits the strip
    const vscale = (H * 0.5) / ((W * 0.94 / 3) * 0.866);
    function level(l: number): [number, number][] {
      let pts: [number, number][] = [[W * 0.03, H * 0.7], [W * 0.97, H * 0.7]];
      for (let i = 0; i < l; i++) {
        const next: [number, number][] = [];
        for (let j = 0; j < pts.length - 1; j++) {
          const [x1, y1] = pts[j], [x2, y2] = pts[j + 1];
          const dx = (x2 - x1) / 3, dy = (y2 - y1) / 3;
          const bump = Math.hypot(dx, dy) * 0.866 * vscale;
          const px = x1 + 1.5 * dx;
          const py = y1 + 1.5 * dy - bump;
          next.push([x1, y1], [x1 + dx, y1 + dy], [px, py], [x1 + 2 * dx, y1 + 2 * dy]);
        }
        next.push(pts[pts.length - 1]);
        pts = next;
      }
      return pts;
    }
    const levels = Array.from({ length: maxLevel + 1 }, (_, i) => level(i));
    let cur = 0, prog = 0;
    const drawSecs = 2.2;
    return {
      frame(dt) {
        prog += dt / drawSecs;
        if (prog >= 1.35) {
          prog = 0;
          cur = (cur + 1) % (maxLevel + 1);
          if (cur === 0) ctx.clearRect(0, 0, W, H);
        }
        fadeRect(ctx, W, H, bg, 0.08);
        const pts = levels[cur];
        const n = Math.max(2, Math.floor(pts.length * Math.min(1, prog)));
        ctx.strokeStyle = ink;
        ctx.lineWidth = 1.4;
        ctx.globalAlpha = 0.9;
        ctx.beginPath();
        ctx.moveTo(pts[0][0], pts[0][1]);
        for (let i = 1; i < n; i++) ctx.lineTo(pts[i][0], pts[i][1]);
        ctx.stroke();
        ctx.globalAlpha = 1;
      },
    };
  };

  // ---- chaos: the chaos game on a seeded polygon stretched across the strip ----
  const chaos: Maker = (ctx, W, H, rng, ink, bg) => {
    const opts = [
      { sides: 3, ratio: 0.5 },
      { sides: 5, ratio: 0.38 },
      { sides: 6, ratio: 0.33 },
      { sides: 4, ratio: 0.5, noRepeat: true },
    ];
    const o = opts[Math.floor(rng() * opts.length)];
    const rot = rng() * TAU;
    const verts = Array.from({ length: o.sides }, (_, i) => {
      const a = rot + (i * TAU) / o.sides;
      return [W / 2 + Math.cos(a) * W * 0.42, H / 2 + Math.sin(a) * H * 0.42];
    });
    let p = [W / 2, H / 2];
    let last = -1, n = 0;
    return {
      frame(dt, t) {
        if (n > 42000) { ctx.clearRect(0, 0, W, H); n = 0; }
        const per = Math.min(500, 8 + Math.floor(t * t * 3));
        ctx.fillStyle = ink;
        ctx.globalAlpha = 0.5;
        for (let i = 0; i < per; i++) {
          let vi = Math.floor(Math.random() * o.sides);
          if (o.noRepeat && vi === last) vi = (vi + 1) % o.sides;
          last = vi;
          const v = verts[vi];
          p = [p[0] + (v[0] - p[0]) * (1 - o.ratio) , p[1] + (v[1] - p[1]) * (1 - o.ratio)];
          ctx.fillRect(p[0], p[1], 1, 1);
          n++;
        }
        ctx.globalAlpha = 1;
      },
    };
  };

  // ---- sierpinski: a scrolling texture of triforce triangles drifting past ----
  const sierpinski: Maker = (ctx, W, H, rng, ink, bg) => {
    const depth = 2 + Math.floor(rng() * 2);                       // 2 = the classic triforce
    const s = H * (0.62 + rng() * 0.35);                           // triangle side
    const rowH = s * 0.866;
    const speed = (9 + rng() * 13) * (rng() < 0.5 ? -1 : 1);       // px/s drift
    const rows = Math.ceil(H / rowH) + 1;

    // pre-render one horizontally-tileable strip at 2x for crispness
    const scale = 2;
    const tile = document.createElement('canvas');
    tile.width = s * scale;
    tile.height = H * scale;
    const tc = tile.getContext('2d')!;
    tc.scale(scale, scale);
    tc.fillStyle = ink;
    function tri(x: number, y: number, side: number, d: number) {
      if (d === 0) {
        tc.beginPath();
        tc.moveTo(x + side / 2, y);
        tc.lineTo(x + side, y + side * 0.866);
        tc.lineTo(x, y + side * 0.866);
        tc.closePath();
        tc.fill();
        return;
      }
      const h = side / 2;
      tri(x + h / 2, y, h, d - 1);
      tri(x, y + h * 0.866, h, d - 1);
      tri(x + h, y + h * 0.866, h, d - 1);
    }
    for (let r = 0; r < rows; r++) {
      const y = -rowH * 0.25 + r * rowH;
      const stagger = (r % 2) * (s / 2);
      tc.globalAlpha = r % 2 === 0 ? 0.34 : 0.2;
      for (const off of [-s, 0, s]) tri(off + stagger, y, s, depth);
    }

    return {
      frame(dt, t) {
        ctx.clearRect(0, 0, W, H);
        const offset = (((t * speed) % s) + s) % s - s;
        for (let x = offset; x < W; x += s) ctx.drawImage(tile, x, 0, s, H);
      },
    };
  };

  // ---- grove: trees growing along the bottom, then regrowing differently ----
  const grove: Maker = (ctx, W, H, rng, ink, bg) => {
    interface Seg { x1: number; y1: number; x2: number; y2: number; d: number; w: number }
    let segs: Seg[] = [];
    let maxD = 0;
    function grow(x: number, y: number, ang: number, len: number, d: number, w: number, jitter: number, spread: number, r: Rng) {
      if (d > 7 || len < 2.5) return;
      maxD = Math.max(maxD, d);
      const x2 = x + Math.cos(ang) * len, y2 = y + Math.sin(ang) * len;
      segs.push({ x1: x, y1: y, x2, y2, d, w });
      for (const side of [-0.5, 0.5]) {
        grow(x2, y2, ang + side * spread + (r() - 0.5) * jitter, len * (0.66 + (r() - 0.5) * 0.08), d + 1, w * 0.72, jitter, spread, r);
      }
    }
    function plant() {
      segs = []; maxD = 0;
      const r = mulberry32((rng() * 1e9) | 0);
      const count = 2 + Math.floor(r() * 3);
      for (let i = 0; i < count; i++) {
        const x = W * (0.12 + (0.76 * i) / Math.max(1, count - 1)) + (r() - 0.5) * W * 0.06;
        grow(x, H * 1.02, -Math.PI / 2 + (r() - 0.5) * 0.2, H * (0.3 + r() * 0.12), 0, 2.4, 0.55 + r() * 0.5, 1.05 + r() * 0.6, r);
      }
    }
    plant();
    let depth = 0;
    const perLevel = 0.85;
    return {
      frame(dt) {
        depth += dt / perLevel;
        if (depth > maxD + 4.5) { depth = 0; plant(); ctx.clearRect(0, 0, W, H); }
        fadeRect(ctx, W, H, bg, 0.045);
        ctx.strokeStyle = ink;
        ctx.lineCap = 'round';
        for (const s of segs) {
          if (s.d > depth) continue;
          const f = Math.min(1, depth - s.d);
          ctx.lineWidth = Math.max(0.5, s.w);
          ctx.globalAlpha = 0.35 + 0.5 * (1 - s.d / 8);
          ctx.beginPath();
          ctx.moveTo(s.x1, s.y1);
          ctx.lineTo(s.x1 + (s.x2 - s.x1) * f, s.y1 + (s.y2 - s.y1) * f);
          ctx.stroke();
        }
        ctx.globalAlpha = 1;
      },
    };
  };

  // ---- loops: a chain of loops, output feeding input, dots forever circling ----
  const loops: Maker = (ctx, W, H, rng, ink, bg) => {
    const count = 3 + Math.floor(rng() * 3);
    const rings = Array.from({ length: count }, (_, i) => ({
      x: W * (0.14 + (0.72 * i) / Math.max(1, count - 1)),
      y: H / 2 + (rng() - 0.5) * H * 0.25,
      r: H * (0.18 + rng() * 0.16),
      speed: (0.4 + rng() * 0.8) * (rng() < 0.4 ? -1 : 1),
      phase: rng() * TAU,
    }));
    return {
      frame(dt, t) {
        fadeRect(ctx, W, H, bg, 0.055);
        ctx.strokeStyle = ink;
        for (let i = 0; i < rings.length; i++) {
          const g = rings[i];
          ctx.globalAlpha = 0.22;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(g.x, g.y, g.r, 0, TAU);
          ctx.stroke();
          if (i < rings.length - 1) {
            const nx = rings[i + 1];
            ctx.globalAlpha = 0.16;
            ctx.beginPath();
            ctx.moveTo(g.x + g.r, g.y);
            ctx.lineTo(nx.x - nx.r, nx.y);
            ctx.stroke();
          }
          const a = g.phase + t * g.speed * 1.6;
          ctx.globalAlpha = 0.95;
          ctx.fillStyle = ink;
          ctx.beginPath();
          ctx.arc(g.x + Math.cos(a) * g.r, g.y + Math.sin(a) * g.r, 2.4, 0, TAU);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
      },
    };
  };

  // ---- ferns: Barnsley ferns accumulating point by point ----
  const ferns: Maker = (ctx, W, H, rng, ink, bg) => {
    const count = 1 + Math.floor(rng() * 3);
    const plots = Array.from({ length: count }, () => ({
      cx: W * (0.2 + rng() * 0.6), sc: H * (0.16 + rng() * 0.05), flip: rng() < 0.5 ? -1 : 1,
      x: 0, y: 0,
    }));
    let n = 0;
    return {
      frame(dt, t) {
        if (n > 26000) { ctx.clearRect(0, 0, W, H); n = 0; }
        const per = Math.min(260, 6 + Math.floor(t * t * 2));
        ctx.fillStyle = ink;
        ctx.globalAlpha = 0.55;
        for (let i = 0; i < per; i++) {
          const p = plots[n % plots.length];
          const r = Math.random();
          let nx: number, ny: number;
          if (r < 0.01) { nx = 0; ny = 0.16 * p.y; }
          else if (r < 0.86) { nx = 0.85 * p.x + 0.04 * p.y; ny = -0.04 * p.x + 0.85 * p.y + 1.6; }
          else if (r < 0.93) { nx = 0.2 * p.x - 0.26 * p.y; ny = 0.23 * p.x + 0.22 * p.y + 1.6; }
          else { nx = -0.15 * p.x + 0.28 * p.y; ny = 0.26 * p.x + 0.24 * p.y + 0.44; }
          p.x = nx; p.y = ny;
          ctx.fillRect(p.cx + p.flip * p.x * p.sc * 0.55, H - 4 - p.y * p.sc * 0.52, 1, 1);
          n++;
        }
        ctx.globalAlpha = 1;
      },
    };
  };

  // ---- spirals: a story circling outward, growing embellishment each turn ----
  const spirals: Maker = (ctx, W, H, rng, ink, bg) => {
    const count = 1 + Math.floor(rng() * 2);
    const homes = Array.from({ length: count }, (_, i) => ({
      cx: W * (count === 1 ? 0.5 : 0.28 + 0.44 * i), cy: H * 0.52,
      dir: rng() < 0.5 ? -1 : 1, phase: rng() * TAU,
    }));
    let t0 = 0;
    const cycle = 11;
    return {
      frame(dt, t) {
        t0 += dt;
        if (t0 > cycle) { t0 = 0; ctx.clearRect(0, 0, W, H); }
        fadeRect(ctx, W, H, bg, 0.012);
        ctx.strokeStyle = ink;
        for (const h of homes) {
          const a0 = h.phase + h.dir * t0 * 2.2;
          const r0 = 2 * Math.exp(t0 * 0.32);
          if (r0 > H * 0.62) continue;
          const a1 = h.phase + h.dir * (t0 + dt) * 2.2;
          const r1 = 2 * Math.exp((t0 + dt) * 0.32);
          ctx.globalAlpha = 0.85;
          ctx.lineWidth = 1.3;
          ctx.beginPath();
          ctx.moveTo(h.cx + Math.cos(a0) * r0 * 1.6, h.cy + Math.sin(a0) * r0);
          ctx.lineTo(h.cx + Math.cos(a1) * r1 * 1.6, h.cy + Math.sin(a1) * r1);
          ctx.stroke();
          // embellishments sprout as the story grows
          if (Math.floor(a0 / (Math.PI / 3)) !== Math.floor(a1 / (Math.PI / 3)) && r0 > 8) {
            const bx = h.cx + Math.cos(a1) * r1 * 1.6, by = h.cy + Math.sin(a1) * r1;
            ctx.globalAlpha = 0.45;
            ctx.lineWidth = 0.8;
            for (const s of [-0.6, 0.6]) {
              ctx.beginPath();
              ctx.moveTo(bx, by);
              ctx.lineTo(bx + Math.cos(a1 + s) * r1 * 0.25, by + Math.sin(a1 + s) * r1 * 0.25);
              ctx.stroke();
            }
          }
        }
        ctx.globalAlpha = 1;
      },
    };
  };

  // ---- rings: the Weaving layout — nested rings, each turning at its own pace ----
  const rings: Maker = (ctx, W, H, rng, ink, bg) => {
    const cx = W / 2, cy = H / 2;
    const base = H * 0.16;
    const rs = [base, base * 1.85, base * 2.7];
    const speeds = rs.map((_, i) => (0.5 - i * 0.16) * (rng() < 0.5 ? 1 : -1));
    const phases = rs.map(() => rng() * TAU);
    const aside = { x: W * 0.86, y: H * 0.5, r: base * 0.55 };
    return {
      frame(dt, t) {
        fadeRect(ctx, W, H, bg, 0.06);
        ctx.strokeStyle = ink;
        rs.forEach((r, i) => {
          ctx.globalAlpha = 0.25;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(cx, cy, r, 0, TAU);
          ctx.stroke();
          const a = phases[i] + t * speeds[i] * 1.4;
          ctx.globalAlpha = 0.95;
          ctx.fillStyle = ink;
          ctx.beginPath();
          ctx.arc(cx + Math.cos(a) * r * 1.35, cy + Math.sin(a) * r * 0.92, 2.6, 0, TAU);
          ctx.fill();
        });
        ctx.globalAlpha = 0.3;
        ctx.setLineDash([4, 6]);
        ctx.beginPath();
        ctx.arc(aside.x, aside.y, aside.r, 0, TAU);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.globalAlpha = 1;
      },
    };
  };

  // ---- tide: a reinforcing pull and a balancing return, running together ----
  const tide: Maker = (ctx, W, H, rng, ink, bg) => {
    const layers = Array.from({ length: 3 }, (_, i) => ({
      base: H * (0.42 + i * 0.16),
      amp: H * (0.1 + rng() * 0.05),
      k: 0.008 + rng() * 0.006,
      w: (0.5 + rng() * 0.4) * (i % 2 === 0 ? 1 : -1),
      phase: rng() * TAU,
      alpha: 0.5 - i * 0.13,
    }));
    return {
      frame(dt, t) {
        ctx.clearRect(0, 0, W, H);
        // the tide breathes: amplitude itself rises and returns
        const breathe = 0.75 + 0.25 * Math.sin(t * 0.35);
        ctx.strokeStyle = ink;
        for (const L of layers) {
          ctx.globalAlpha = L.alpha;
          ctx.lineWidth = 1.4;
          ctx.beginPath();
          for (let x = 0; x <= W; x += 3) {
            const y = L.base
              + Math.sin(x * L.k + t * L.w + L.phase) * L.amp * breathe
              + Math.sin(x * L.k * 2.7 + t * L.w * 1.7) * L.amp * 0.3 * breathe;
            if (x === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
          }
          ctx.stroke();
        }
        ctx.globalAlpha = 1;
      },
    };
  };

  const MAKERS: Record<string, Maker> = { koch, chaos, sierpinski, grove, loops, ferns, spirals, rings, tide };

  const host = document.querySelector<HTMLElement>('.hero-fractal');
  const canvas = host?.querySelector('canvas');
  if (host && canvas) {
    const ctx = canvas.getContext('2d')!;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const W = host.clientWidth, H = host.clientHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx.scale(dpr, dpr);
    const style = getComputedStyle(host);
    const ink = style.color;
    const bg = getComputedStyle(document.documentElement).getPropertyValue('--bg2').trim() || '#fff';
    const rng = mulberry32(hashSeed(canvas.dataset.seed || 'fractalism'));
    const anim = MAKERS[canvas.dataset.type || 'grove'](ctx, W, H, rng, ink, bg);

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      // render a settled still frame instead of animating
      let t = 0;
      for (let i = 0; i < 600; i++) { anim.frame(1 / 60, t); t += 1 / 60; }
    } else {
      let last = performance.now();
      let t = 0;
      const tick = (now: number) => {
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;
        t += dt;
        anim.frame(dt, t);
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>
