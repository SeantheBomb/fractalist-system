---
import { getCollection } from 'astro:content';
import { PARTS } from '../../scripts/manifest.mjs';
import { concept } from '../lib/concepts';

interface Props {
  related: string[];
  /** For each related page, the concepts it shares with this one. */
  shared?: Record<string, string[]>;
  nextInPart?: { id: string; data: { title: string; summary: string; part: string } } | null;
}
const { related, shared = {}, nextInPart = null } = Astro.props;

const nodes = await getCollection('nodes');
const thirds = await getCollection('thirds');

const cards = related
  .filter((slug) => slug !== nextInPart?.id)
  .map((slug) => {
    const n = nodes.find((x) => x.id === slug);
    if (n) return {
      href: `/node/${n.id}/`,
      title: n.data.title,
      summary: n.data.summary,
      label: PARTS[n.data.part]?.title ?? '',
      color: PARTS[n.data.part]?.color ?? 'var(--muted)',
      shares: (shared[slug] ?? []).map((s) => concept(s)?.name).filter(Boolean).slice(0, 3),
    };
    const t = thirds.find((x) => x.id === slug);
    if (t) return {
      href: `/thirds/${t.id}/`,
      title: t.data.epithet ? `${t.data.name}, ${t.data.epithet}` : t.data.name,
      summary: t.data.blurb,
      label: 'A Standing Third',
      color: 'var(--c-p5)',
      shares: [] as string[],
    };
    return null;
  })
  .filter(Boolean);
---
{nextInPart && (
  <section class="next-links continue-reading">
    <p class="eyebrow">Continue reading</p>
    <a class="next-card featured continue-card" href={`/node/${nextInPart.id}/`}>
      <div class="nc-part" style={`color: ${PARTS[nextInPart.data.part]?.color ?? 'var(--muted)'}`}>{PARTS[nextInPart.data.part]?.title ?? ''}</div>
      <div class="nc-title">{nextInPart.data.title}</div>
      <div class="nc-summary">{nextInPart.data.summary}</div>
    </a>
  </section>
)}

{cards.length > 0 && (
  <section class="next-links thread-links">
    <p class="eyebrow">Or follow a thread instead</p>
    {cards.map((c) => (
      <a class="next-card" href={c.href}>
        <div class="nc-part" style={`color: ${c.color}`}>{c.label}</div>
        <div class="nc-title">{c.title}</div>
        <div class="nc-summary">{c.summary}</div>
        {c.shares.length > 0 && <div class="nc-shares">Shares {c.shares.join(', ')}</div>}
      </a>
    ))}
  </section>
)}
