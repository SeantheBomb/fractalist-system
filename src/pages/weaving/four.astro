---
import Base from '../../layouts/Base.astro';
import WeavingCard from '../../components/WeavingCard.astro';
---
<Base title="A Four-Point Weaving" description="One card for each ring — Self, Dyad, Skein, Culture — revealed one at a time, with no privileged first card.">
  <h1>A Four-Point Weaving</h1>

  <section id="step-intro" class="wstep">
    <p>
      Hold a real situation in mind — a live conundrum, not a hypothetical. You won't be asked to
      type it, name it, or share it; the whole reading happens against what you're already holding.
    </p>
    <p style="color: var(--muted); font-size: 0.93rem;">
      Four cards will be drawn, one for each ring — <strong>Self</strong>, <strong>Dyad</strong>,
      <strong>Skein</strong>, <strong>Culture</strong> — read from the center out. None of them gets
      special priority just for being drawn first. Take each card slowly. A card that clearly doesn't
      fit tells you as much about the real shape of your situation as one that lands cleanly.
    </p>
    <p style="color: var(--muted); font-size: 0.88rem;">
      One thing worth saying once before you begin, rather than drawing a card for it: whatever these
      four show, the whole reading is still one small, summed part of something no single Weaving was
      ever going to capture completely. That's the Cosmos-Kin's only figure, the Infinite Boundary —
      never drawn, because there's only one, and it already holds every Weaving before a card is
      turned over.
    </p>
    <button class="big-btn" data-next type="button">Draw the Self ring</button>
  </section>

  <section class="wstep" data-ring="self" hidden>
    <p class="eyebrow">The innermost ring · Self</p>
    <div class="slot"></div>
    <p class="wprompt">
      This ring is about what's happening <em>in you</em>, at your own scale — not what anyone else
      is doing. Is this pattern, in you, doing the thing it's good at, or has it tipped?
    </p>
    <button class="big-btn" data-next type="button">Draw the Dyad ring</button>
  </section>

  <section class="wstep" data-ring="dyad" hidden>
    <p class="eyebrow">The second ring · Dyad</p>
    <div class="slot"></div>
    <p class="wprompt">
      This ring is about what's happening between you and <em>one specific other person</em> inside
      the situation. If nobody comes to mind at first, notice who you thought of anyway.
    </p>
    <button class="big-btn" data-next type="button">Draw the Skein ring</button>
  </section>

  <section class="wstep" data-ring="skein" hidden>
    <p class="eyebrow">The third ring · Skein</p>
    <div class="slot"></div>
    <p class="wprompt">
      This ring is about the scale of the group around you — the family, team, or community the
      situation is nested inside, whether or not they know about it.
    </p>
    <button class="big-btn" data-next type="button">Draw the Culture ring</button>
  </section>

  <section class="wstep" data-ring="culture" hidden>
    <p class="eyebrow">The outermost ring · Culture</p>
    <div class="slot"></div>
    <p class="wprompt">
      This ring is about a scale beyond any single group you could name — the shared story, the
      invented "we," the pattern operating across a whole society or institution the situation sits
      inside of.
    </p>
    <button class="big-btn" data-next type="button">Lay out the rings</button>
  </section>

  <section id="step-final" class="wstep" hidden>
    <p class="eyebrow">The Weaving, laid out</p>
    <p style="color: var(--muted); font-size: 0.93rem;">
      Read from the center out, or the edge in — never as a timeline. And the rings do not have to
      agree: handling something well at your own scale while it frays at the group's scale is exactly
      the kind of information one flat view would have missed.
    </p>

    <div class="rings">
      <div class="ring culture-ring">
        <span class="ring-label">Culture</span>
        <div class="ring-mini" data-mini="culture"></div>
        <div class="ring skein-ring">
          <span class="ring-label">Skein</span>
          <div class="ring-mini" data-mini="skein"></div>
          <div class="ring dyad-ring">
            <span class="ring-label">Dyad</span>
            <div class="ring-mini" data-mini="dyad"></div>
            <div class="ring self-ring">
              <span class="ring-label">Self</span>
              <div class="ring-mini" data-mini="self"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="cosmos-aside">
        <span class="ring-label">Cosmos — never drawn</span>
        <p>
          The Infinite Boundary holds the whole arrangement without being placed as a card —
          the edge the four rings above already sit inside.
        </p>
      </div>
    </div>

    <p style="font-size: 0.9rem; color: var(--muted); margin-top: 1.5rem;">
      A Weaving describes a pattern already present; it never predicts an outcome, and it cannot tell
      you what to do — <a href="/node/reading-honestly/">reading honestly</a> ·
      <a href="/node/weaving-limits/">what a Weaving cannot show</a>. The genuinely useful card is
      often the uncomfortable one.
    </p>

    <div class="final-actions">
      <button id="copy-link" class="big-btn" type="button">Copy a link to this spread</button>
      <a class="big-btn" href="/weaving/four/">Weave again</a>
    </div>
  </section>

  <WeavingCard />
</Base>

<style>
  .wstep { margin-top: 2rem; }
  .wprompt {
    border-left: 2px solid var(--line);
    padding-left: 1rem;
    color: var(--muted);
    font-size: 0.95rem;
    margin: 1.3rem 0;
  }
  .slot { margin-top: 1rem; }
  .wstep .big-btn { margin-top: 0.4rem; }

  .rings { margin-top: 1.5rem; }
  .ring {
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 1rem;
    position: relative;
  }
  .culture-ring { border-color: color-mix(in srgb, var(--k-culture) 55%, var(--line)); }
  .skein-ring { border-color: color-mix(in srgb, var(--k-skein) 55%, var(--line)); margin-top: 0.8rem; }
  .dyad-ring { border-color: color-mix(in srgb, var(--k-dyad) 55%, var(--line)); margin-top: 0.8rem; }
  .self-ring { border-color: color-mix(in srgb, var(--k-fire) 45%, var(--line)); margin-top: 0.8rem; }
  .ring-label {
    font-family: var(--sans); font-size: 0.66rem; text-transform: uppercase;
    letter-spacing: 0.14em; color: var(--muted);
  }
  .ring-mini { display: flex; gap: 0.8rem; align-items: center; margin-top: 0.4rem; }
  .ring-mini .mini-art { width: 54px; flex-shrink: 0; }
  .ring-mini .mini-art :global(svg) { display: block; width: 100%; height: auto; }
  .ring-mini .mini-name { font-weight: 600; }
  .ring-mini .mini-pick { font-family: var(--sans); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
  .cosmos-aside {
    border: 1px dashed var(--line);
    border-radius: 18px;
    padding: 1rem;
    margin-top: 1rem;
  }
  .cosmos-aside p { font-size: 0.85rem; color: var(--muted); margin: 0.5rem 0 0; }
  .final-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 1.5rem; }
</style>

<script>
  const deck = Array.from(document.querySelectorAll<HTMLElement>('#deck .wcard'));
  const bySlug = new Map(deck.map((c) => [c.dataset.slug!, c]));
  const byKin = (k: string) => deck.filter((c) => c.dataset.kinship === k);
  const steps = Array.from(document.querySelectorAll<HTMLElement>('.wstep'));
  const drawn: Record<string, string> = {};

  function draw(kinship: string): HTMLElement {
    const pool = byKin(kinship);
    return pool[Math.floor(Math.random() * pool.length)];
  }

  function reveal(step: HTMLElement, source: HTMLElement) {
    const card = source.cloneNode(true) as HTMLElement;
    card.hidden = false;
    card.querySelectorAll<HTMLButtonElement>('.wc-reading').forEach((b) => {
      b.addEventListener('click', () => {
        card.classList.add('chosen');
        card.querySelectorAll('.wc-reading').forEach((x) => x.classList.remove('picked'));
        b.classList.add('picked');
        drawn[step.dataset.ring! + ':pick'] = b.dataset.mode!;
        renderMinis();
      });
    });
    step.querySelector('.slot')!.replaceChildren(card);
  }

  const ringOrder = ['self', 'dyad', 'skein', 'culture'];

  function renderMinis() {
    for (const ring of ringOrder) {
      const slug = drawn[ring];
      const mini = document.querySelector<HTMLElement>(`[data-mini="${ring}"]`);
      if (!slug || !mini) continue;
      const src = bySlug.get(slug)!;
      const art = src.querySelector('.wc-art')!.cloneNode(true) as HTMLElement;
      art.className = 'mini-art';
      const name = src.querySelector('.wc-name')!.textContent;
      const pick = drawn[ring + ':pick'];
      mini.replaceChildren(art);
      const label = document.createElement('div');
      label.innerHTML = `<div class="mini-name">${name}</div><div class="mini-pick">${pick ? pick : 'tending or fraying — yours to decide'}</div>`;
      mini.appendChild(label);
    }
  }

  let stepIdx = 0;

  function goNext() {
    steps[stepIdx].querySelector<HTMLButtonElement>('[data-next]')?.setAttribute('disabled', 'true');
    stepIdx++;
    const step = steps[stepIdx];
    if (!step) return;
    step.hidden = false;
    const ring = step.dataset.ring;
    if (ring) {
      const card = drawn[ring] ? bySlug.get(drawn[ring])! : draw(ring);
      drawn[ring] = card.dataset.slug!;
      reveal(step, card);
    }
    if (step.id === 'step-final') renderMinis();
    step.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  document.querySelectorAll('[data-next]').forEach((b) => b.addEventListener('click', goNext));

  document.getElementById('copy-link')!.addEventListener('click', async (e) => {
    const w = ringOrder.map((r) => drawn[r]).join('.');
    const url = `${location.origin}/weaving/four/?w=${w}`;
    try {
      await navigator.clipboard.writeText(url);
      (e.currentTarget as HTMLElement).textContent = 'Link copied';
    } catch {
      prompt('Copy this link:', url);
    }
  });

  // Shared spread: ?w=self.dyad.skein.culture reveals everything at once.
  const params = new URLSearchParams(location.search);
  const w = params.get('w');
  if (w) {
    const slugs = w.split('.');
    if (slugs.length === 4 && slugs.every((s) => bySlug.has(s))) {
      ringOrder.forEach((r, i) => { drawn[r] = slugs[i]; });
      // walk every step open
      while (stepIdx < steps.length - 1) goNext();
      document.getElementById('step-intro')!.insertAdjacentHTML(
        'afterbegin',
        '<p class="eyebrow" style="color: var(--c-p6)">A shared spread — someone laid this Weaving out and passed it to you.</p>'
      );
    }
  }
</script>
