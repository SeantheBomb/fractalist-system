---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { PARTS } from '../../scripts/manifest.mjs';
import galaxy from '../data/galaxy.json';

// The hierarchy — core, topics, clusters, bodies, bridges — is built from the concept graph
// by scripts/galaxy.mjs. This page only adds what the map needs to draw it.
const nodes = await getCollection('nodes');
const partOf = Object.fromEntries(nodes.map((n) => [n.id, n.data.part]));

const TOPIC_HUES = ['var(--c-p1)', 'var(--c-p3)', 'var(--c-p5)', 'var(--c-p2)', 'var(--c-p7)', 'var(--c-p4)', 'var(--c-p6)', 'var(--k-culture)', 'var(--k-water)', 'var(--k-earth)'];

const pageColor = (id: string) => (id.startsWith('p:') ? PARTS[partOf[id.slice(2)]]?.color ?? 'var(--muted)' : null);
const data = {
  core: { ...galaxy.core, color: pageColor(galaxy.core.id) },
  topics: galaxy.topics.map((t, i) => ({ ...t, hue: TOPIC_HUES[i % TOPIC_HUES.length] })),
  bodies: Object.fromEntries(Object.entries(galaxy.bodies).map(([id, b]) => [id, { ...b, partColor: pageColor(id) }])),
  bridges: galaxy.bridges,
  dyads: galaxy.dyads,
};
---
<Base title="The Map" description="Fractalism as a galaxy: a handful of topics orbiting what you already know, each made of clusters, each cluster made of the concepts and chapters that belong together." wide>
  <h1>The Map</h1>
  <p class="map-intro">
    Everything here orbits one center: what you already know. From the whole Cosmos you'll see a
    handful of topics. Zoom into one to find the clusters it's made of, then into a cluster to find
    its concepts and chapters, the Dyads between them drawn as threads. Standing Thirds whose
    ancestry spans two topics drift in the space between them.
  </p>

  <div class="crumb-bar" id="crumb-bar" role="navigation" aria-label="Where you are"></div>

  <div class="map-frame">
    <svg id="graph" viewBox="0 0 1100 860" xmlns="http://www.w3.org/2000/svg" role="application" aria-label="The Fractalism galaxy map">
      <defs>
        <radialGradient id="halo-grad">
          <stop offset="0%" stop-color="currentColor" stop-opacity="0.22" />
          <stop offset="60%" stop-color="currentColor" stop-opacity="0.08" />
          <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
        </radialGradient>
      </defs>
      <g id="camera">
        <g id="dust"></g>
        <g id="topicHalos"></g>
        <g id="clusterHalos"></g>
        <g id="orbits"></g>
        <g id="clusters"></g>
        <g id="bridgeLayer"></g>
        <g id="coreLayer"></g>
        <g id="clusterLabels"></g>
        <g id="topicLabels"></g>
      </g>
    </svg>
    <div class="vignette" aria-hidden="true"></div>
    <div class="map-controls">
      <button id="zoom-in" type="button" aria-label="Zoom in">+</button>
      <button id="zoom-out" type="button" aria-label="Zoom out">−</button>
      <button id="zoom-reset" type="button" aria-label="Back to the whole Cosmos">⟲</button>
    </div>
    <div id="node-card" class="node-card" hidden></div>
  </div>

  <p class="map-legend">
    <span id="thread-count"></span>
    Drag to pan, scroll or pinch to zoom, click a topic or cluster to fly in. Filled stars are
    concepts, rings are chapters. Click one to bring it close, then again to open it.
    Prefer a list? <a href="/concepts/">Every concept</a>, or <a href="/book/">the Book</a> in order.
  </p>

  <script type="application/json" id="galaxy-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
</Base>

<style is:global>
  .map-intro { max-width: 44rem; color: var(--muted); }
  .crumb-bar {
    display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;
    margin-top: 1.5rem; font-family: var(--sans); font-size: 0.85rem; min-height: 1.6rem;
  }
  .crumb-bar button { font: inherit; background: none; border: none; color: var(--muted); cursor: pointer; padding: 0.15rem 0.3rem; border-radius: 6px; }
  .crumb-bar button:hover, .crumb-bar button:focus-visible { color: var(--accent); background: var(--bg2); }
  .crumb-bar .crumb-current { color: var(--ink); font-weight: 600; padding: 0.15rem 0.3rem; }
  .crumb-bar .crumb-sep { color: var(--line); }

  .map-frame { position: relative; border: 1px solid var(--line); border-radius: 14px; background: var(--bg2); margin-top: 0.75rem; overflow: hidden; }
  #graph { display: block; width: 100%; height: min(78vh, 720px); touch-action: none; cursor: grab; user-select: none; }
  #graph.dragging { cursor: grabbing; }
  .vignette { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at center, transparent 55%, color-mix(in srgb, var(--ink) 9%, transparent) 100%); }

  #dust circle { fill: var(--muted); }
  #dust circle.tw { animation: dust-twinkle 5s ease-in-out infinite; }
  @keyframes dust-twinkle { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }

  .topic-halo { fill: url(#halo-grad); cursor: pointer; }
  .topic-halo.hot { filter: brightness(1.15); }
  .cluster-halo { fill-opacity: 0.07; stroke-opacity: 0.35; stroke-dasharray: 2 5; cursor: pointer; transition: fill-opacity 0.15s ease; }
  .cluster-halo.hot { fill-opacity: 0.16; stroke-opacity: 0.7; }
  #orbits circle { fill: none; stroke: var(--muted); stroke-opacity: 0.18; stroke-dasharray: 1 6; }

  .body { cursor: pointer; }
  .body circle, .body rect { transition: opacity 0.15s ease; }
  .body .page { fill: var(--bg2); }
  .body .mark { transform-box: view-box; transform-origin: 0 0; transform: scale(var(--ms, 1)); }
  .body rect.mark { transform: scale(var(--ms, 1)) rotate(45deg); }
  .body text { dominant-baseline: hanging; transform: translateY(calc(var(--r) * var(--ms, 1) * 1px + 0.35em)); }
  .body text {
    font-family: var(--sans); fill: var(--ink); text-anchor: middle; pointer-events: none;
    paint-order: stroke; stroke: var(--bg2); stroke-linejoin: round; opacity: var(--lbl, 0);
  }
  .body.visited .mark { filter: drop-shadow(0 0 2px currentColor); }
  .body.hot .mark { filter: drop-shadow(0 0 4px currentColor); }
  .body.hot text, .body.focus text { opacity: 1; font-weight: 600; }
  .body.dim { opacity: 0.18; }
  .dyad { stroke: var(--muted); stroke-opacity: 0.35; vector-effect: non-scaling-stroke; }
  .dyad.stems, .dyad.fuses, .dyad.personifies { stroke: var(--accent); stroke-opacity: 0.5; }
  .dyad.fuses, .dyad.personifies { stroke-dasharray: 3 3; }
  .dyad.hot { stroke-opacity: 1; stroke-width: 2; }

  .bridge { cursor: pointer; }
  .bridge text { font-family: var(--sans); fill: var(--ink); text-anchor: middle; pointer-events: none; paint-order: stroke; stroke: var(--bg2); stroke-linejoin: round; opacity: var(--blbl, 0); }
  .bridge.hot text { opacity: 1; }

  #coreLayer .core-glow { fill: url(#halo-grad); color: var(--gold); pointer-events: none; }
  #coreLayer text { font-family: var(--sans); text-anchor: middle; fill: var(--ink); paint-order: stroke; stroke: var(--bg2); stroke-linejoin: round; pointer-events: none; }

  #topicLabels text, #clusterLabels text {
    font-family: var(--sans); text-anchor: middle; pointer-events: none;
    paint-order: stroke; stroke: var(--bg2); stroke-linejoin: round; fill: var(--ink);
  }
  #topicLabels text { font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  #topicLabels text .sub { font-weight: 400; letter-spacing: 0.02em; text-transform: none; font-size: 0.72em; fill: var(--muted); }
  #clusterLabels text { font-weight: 500; }

  .map-controls { position: absolute; right: 0.75rem; bottom: 0.75rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .map-controls button { width: 30px; height: 30px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); font-size: 1rem; line-height: 1; cursor: pointer; }
  .map-controls button:hover, .map-controls button:focus-visible { border-color: var(--accent); }

  .node-card {
    position: absolute; left: 0.85rem; top: 0.85rem; max-width: 18rem;
    background: var(--bg); border: 1px solid var(--line); border-radius: 10px;
    padding: 0.65rem 0.85rem; font-family: var(--sans); font-size: 0.78rem; pointer-events: none;
  }
  .node-card.pinned { pointer-events: auto; }
  .node-card .nc-part { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .node-card .nc-title { font-family: var(--serif); font-size: 1.05rem; margin-top: 0.15rem; color: var(--ink); }
  .node-card .nc-sub { margin-top: 0.35rem; color: var(--muted); line-height: 1.45; }
  .node-card .nc-open { display: inline-block; margin-top: 0.55rem; font-weight: 600; }

  .map-legend { font-family: var(--sans); font-size: 0.85rem; color: var(--muted); margin-top: 1rem; }
  @media (prefers-reduced-motion: reduce) { #dust circle.tw { animation: none; } }
</style>

<script>
  type Kind = 'idea' | 'word' | 'figure' | 'page';
  interface BodyData { kind: Kind; title: string; href: string; blurb: string; topic?: string; cluster?: string; weight: number; bridge?: [string, string]; partColor: string | null }
  interface ClusterData { id: string; name: string; anchor: string; bodies: string[] }
  interface TopicData { id: string; name: string; anchor: string; hue: string; clusters: ClusterData[] }
  interface Galaxy {
    core: { id: string; title: string; href: string; blurb: string; color: string | null; companions: { id: string; title: string; href: string; blurb: string; kind: Kind }[] };
    topics: TopicData[]; bodies: Record<string, BodyData>; bridges: string[]; dyads: [string, string, string][];
  }
  const G = JSON.parse(document.getElementById('galaxy-data')!.textContent || '{}') as Galaxy;

  const NS = 'http://www.w3.org/2000/svg';
  const $ = (id: string) => document.getElementById(id)!;
  const svg = $('graph') as unknown as SVGSVGElement;
  const camera = $('camera');
  const nodeCard = $('node-card') as HTMLDivElement;
  const crumbBar = $('crumb-bar');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const el = <K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number> = {}, parent?: Element) => {
    const e = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    parent?.appendChild(e);
    return e;
  };
  const hash = (s: string) => { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return (h >>> 0) / 4294967296; };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const band = (v: number, a: number, b: number) => { if (v <= a) return 0; if (v >= b) return 1; const t = (v - a) / (b - a); return t * t * (3 - 2 * t); };

  // ---- layout: every system is sized by what it holds, bottom-up ----
  const bodyR = (b: BodyData) => 2.4 + Math.min(3.6, Math.sqrt(b.weight) * 0.85);
  interface Orbit { radius: number; phase: number; speed: number }
  interface ClusterSys { data: ClusterData; topic: TopicSys; size: number; orbit: Orbit; x: number; y: number; bodyOrbits: Map<string, Orbit> }
  interface TopicSys { data: TopicData; size: number; clusterRing: number; orbit: Orbit; clusters: ClusterSys[]; x: number; y: number; count: number }

  // Inner orbits turn faster, as a real system's would. Radians per second.
  const SPEED = { body: 0.05, cluster: 0.014, topic: 0.0035, core: 0.03 };
  const topics: TopicSys[] = G.topics.map((t) => {
    const clusters: ClusterSys[] = t.clusters.map((c) => {
      const n = c.bodies.length;
      const inner = Math.min(n, 6), outer = n - inner;
      const r1 = Math.max(13, (inner * 17) / (2 * Math.PI));
      const r2 = r1 + 15;
      const bodyOrbits = new Map<string, Orbit>();
      c.bodies.forEach((b, i) => {
        const onInner = i < inner;
        const k = onInner ? i : i - inner, of = onInner ? inner : outer;
        bodyOrbits.set(b, { radius: onInner ? r1 : r2, phase: (k / of) * Math.PI * 2 + hash(c.id) * 6.28, speed: SPEED.body * (onInner ? 1 : 0.7) });
      });
      return { data: c, topic: null as unknown as TopicSys, size: (outer ? r2 : r1) + 8, orbit: { radius: 0, phase: 0, speed: 0 }, x: 0, y: 0, bodyOrbits };
    });
    const sum = clusters.reduce((s, c) => s + c.size * 2.3, 0);
    const clusterRing = clusters.length === 1 ? 0 : Math.max(Math.max(...clusters.map((c) => c.size)) * 1.3, sum / (2 * Math.PI));
    let acc = 0;
    clusters.forEach((c) => { const share = (c.size * 2.3) / sum; c.orbit = { radius: clusterRing, phase: (acc + share / 2) * Math.PI * 2, speed: SPEED.cluster }; acc += share; });
    const size = clusterRing + Math.max(...clusters.map((c) => c.size)) + 14;
    const t2: TopicSys = { data: t, size, clusterRing, orbit: { radius: 0, phase: 0, speed: 0 }, clusters, x: 0, y: 0, count: t.clusters.reduce((s, c) => s + c.bodies.length, 0) };
    clusters.forEach((c) => (c.topic = t2));
    return t2;
  });
  const topicSum = topics.reduce((s, t) => s + t.size * 3.1, 0);
  const topicRing = Math.max(topicSum / (2 * Math.PI), Math.max(...topics.map((t) => t.size)) + 120);
  {
    let acc = 0;
    topics.forEach((t) => { const share = (t.size * 3.1) / topicSum; t.orbit = { radius: topicRing, phase: (acc + share / 2) * Math.PI * 2 - Math.PI / 2, speed: SPEED.topic }; acc += share; });
  }
  const galaxyRadius = topicRing + Math.max(...topics.map((t) => t.size));
  const topicById = new Map(topics.map((t) => [t.data.id, t]));
  const clusterById = new Map(topics.flatMap((t) => t.clusters.map((c) => [c.data.id, c] as const)));
  const clusterOfBody = new Map<string, ClusterSys>();
  for (const c of clusterById.values()) for (const b of c.data.bodies) clusterOfBody.set(b, c);

  // ---- viewBox follows the frame so tall screens don't letterbox ----
  let VW = 1100, VH = 860;
  const syncViewBox = () => { const r = svg.getBoundingClientRect(); if (r.width && r.height) VH = Math.round(VW * (r.height / r.width)); svg.setAttribute('viewBox', `0 0 ${VW} ${VH}`); };
  syncViewBox();

  // ---- background dust ----
  {
    let s = 20260917;
    const rnd = () => { s = (s * 1664525 + 1013904223) >>> 0; return s / 4294967296; };
    const dust = $('dust');
    for (let i = 0; i < 700; i++) {
      const a = rnd() * Math.PI * 2, rad = Math.pow(rnd(), 0.55) * galaxyRadius * 1.8;
      const c = el('circle', { cx: (Math.cos(a) * rad).toFixed(1), cy: (Math.sin(a) * rad).toFixed(1), r: (0.6 + rnd() * 1.1).toFixed(2), opacity: (0.1 + rnd() * 0.22).toFixed(2) }, dust);
      if (rnd() < 0.2) { c.setAttribute('class', 'tw'); (c as SVGElement).style.animationDelay = `${(rnd() * 5).toFixed(2)}s`; }
    }
  }

  // ---- DOM ----
  const KIND_LABEL: Record<Kind, string> = { idea: 'Concept', word: 'Loop Tongue word', figure: 'Standing Third', page: 'Chapter' };
  let visited = new Set<string>();
  try { visited = new Set((JSON.parse(localStorage.getItem('fractalism-thread') || '[]') as string[]).map((t) => t.split(':')[1])); } catch {}

  function makeBody(id: string, b: { kind: Kind; title: string; href: string }, color: string, parent: Element, stroke?: string) {
    const a = el('a', { href: b.href, class: 'body' }, parent) as unknown as SVGAElement;
    a.dataset.id = id;
    const r = 'weight' in b ? bodyR(b as BodyData) : 4;
    if (b.kind === 'page') el('circle', { r, class: 'mark page', style: `stroke:${color}; color:${color}`, 'stroke-width': 1.6 }, a);
    else if (b.kind === 'figure') el('rect', { x: -r * 0.8, y: -r * 0.8, width: r * 1.6, height: r * 1.6, class: 'mark', style: `fill:${color}; color:${color}${stroke ? `; stroke:${stroke}; stroke-width:1.4` : ''}` }, a);
    else el('circle', { r, class: 'mark', style: `fill:${color}; color:${color}` }, a);
    const t = el('text', { style: `--r:${r}` }, a);
    t.textContent = b.title;
    if (visited.has(id.slice(2))) a.classList.add('visited');
    return a;
  }

  const topicEls = new Map<string, { halo: SVGCircleElement; label: SVGTextElement }>();
  for (const t of topics) {
    const halo = el('circle', { r: t.size, class: 'topic-halo', style: `color:${t.data.hue}` }, $('topicHalos'));
    halo.dataset.id = t.data.id;
    const label = el('text', {}, $('topicLabels'));
    const l1 = el('tspan', { x: 0 }, label); l1.textContent = t.data.name;
    const l2 = el('tspan', { x: 0, dy: '1.4em', class: 'sub' }, label); l2.textContent = `${t.clusters.length} clusters · ${t.count} bodies`;
    topicEls.set(t.data.id, { halo, label });
  }
  const topicOrbit = el('circle', { r: topicRing }, $('orbits'));
  const clusterEls = new Map<string, { halo: SVGCircleElement; label: SVGTextElement; group: SVGGElement; bodies: Map<string, SVGAElement>; dyads: { line: SVGLineElement; a: string; b: string }[] }>();
  for (const c of clusterById.values()) {
    const halo = el('circle', { r: c.size, class: 'cluster-halo', style: `fill:${c.topic.data.hue}; stroke:${c.topic.data.hue}` }, $('clusterHalos'));
    halo.dataset.id = c.data.id;
    const label = el('text', {}, $('clusterLabels'));
    label.textContent = c.data.name;
    const group = el('g', {}, $('clusters'));
    const dyadG = el('g', {}, group);
    const bodies = new Map<string, SVGAElement>();
    for (const id of c.data.bodies) {
      const b = G.bodies[id];
      bodies.set(id, makeBody(id, b, b.kind === 'page' ? (b.partColor ?? c.topic.data.hue) : c.topic.data.hue, group));
    }
    const dyads = G.dyads.filter(([a, b]) => bodies.has(a) && bodies.has(b)).map(([a, b, kind]) => ({ line: el('line', { class: `dyad ${kind}` }, dyadG), a, b }));
    clusterEls.set(c.data.id, { halo, label, group, bodies, dyads });
  }
  const bridgeEls = new Map<string, SVGAElement>();
  for (const id of G.bridges) {
    const b = G.bodies[id];
    const [ta, tb] = b.bridge!.map((t) => topicById.get(t)!);
    const a = makeBody(id, b, ta.data.hue, $('bridgeLayer'), tb.data.hue);
    a.setAttribute('class', 'body bridge');
    bridgeEls.set(id, a);
  }
  const coreG = $('coreLayer');
  el('circle', { r: 60, class: 'core-glow' }, coreG);
  const coreBody = makeBody(G.core.id, { kind: 'page', title: G.core.title, href: G.core.href }, 'var(--gold)', coreG);
  coreBody.querySelector('circle')!.setAttribute('r', '9');
  coreBody.querySelector('text')!.style.setProperty('--r', '9');
  const companionEls = G.core.companions.map((c) => ({ data: c, a: makeBody(c.id, { kind: 'figure', title: c.title, href: c.href }, 'var(--k-cosmos)', coreG) }));

  // ---- the orbit clock. It stops while you're reading anything. ----
  let clock = 0, lastNow = performance.now(), paused = false;
  const orbitPos = (o: Orbit, cx: number, cy: number) => { const a = o.phase + o.speed * clock; return [cx + Math.cos(a) * o.radius, cy + Math.sin(a) * o.radius] as const; };
  const bodyPos = new Map<string, [number, number]>();

  function place() {
    for (const t of topics) {
      [t.x, t.y] = orbitPos(t.orbit, 0, 0);
      for (const c of t.clusters) {
        [c.x, c.y] = orbitPos(c.orbit, t.x, t.y);
        for (const [id, o] of c.bodyOrbits) bodyPos.set(id, orbitPos(o, c.x, c.y) as [number, number]);
      }
    }
    for (const id of G.bridges) {
      const b = G.bodies[id];
      const [ta, tb] = b.bridge!.map((t) => topicById.get(t)!);
      // along the gap between the two topics, at a steady but individual spot
      const along = 0.5 + (hash(id) - 0.5) * 0.44;
      const dx = tb.x - ta.x, dy = tb.y - ta.y, len = Math.hypot(dx, dy) || 1;
      const side = (hash(id + '/') - 0.5) * 70;
      bodyPos.set(id, [ta.x + dx * along - (dy / len) * side, ta.y + dy * along + (dx / len) * side]);
    }
    G.core.companions.forEach((c, i) => bodyPos.set(c.id, orbitPos({ radius: 30, phase: i * 2.4, speed: SPEED.core }, 0, 0) as [number, number]));
    bodyPos.set(G.core.id, [0, 0]);
  }

  // ---- camera ----
  let camX = VW / 2, camY = VH / 2, camK = 1, k0 = 1;
  type Focus = { kind: 'cosmos' } | { kind: 'topic'; id: string } | { kind: 'cluster'; id: string } | { kind: 'body'; id: string } | null;
  let focus: Focus = { kind: 'cosmos' };
  let flight: { from: [number, number, number]; to: () => [number, number]; k: number; start: number } | null = null;
  const unitsPerPx = () => VW / Math.max(1, svg.getBoundingClientRect().width);
  const screenR = (worldR: number) => (worldR * camK) / unitsPerPx();
  const frameMin = () => { const r = svg.getBoundingClientRect(); return Math.min(r.width, r.height) || 600; };

  const focusTarget = (f: Focus): { at: () => [number, number]; radius: number } => {
    if (!f || f.kind === 'cosmos') return { at: () => [0, 0], radius: galaxyRadius };
    if (f.kind === 'topic') { const t = topicById.get(f.id)!; return { at: () => [t.x, t.y], radius: t.size * 1.25 }; }
    if (f.kind === 'cluster') { const c = clusterById.get(f.id)!; return { at: () => [c.x, c.y], radius: c.size * 1.35 }; }
    return { at: () => bodyPos.get(f.id) ?? [0, 0], radius: 34 };
  };
  const kFor = (radius: number) => { const r = svg.getBoundingClientRect(); const pxR = Math.min(r.width, r.height) * 0.46; return (pxR * unitsPerPx()) / radius; };

  function flyTo(f: Focus) {
    focus = f;
    const { at, radius } = focusTarget(f);
    const k = kFor(radius);
    const cx = (VW / 2 - camX) / camK, cy = (VH / 2 - camY) / camK;
    if (reduced) { const [x, y] = at(); camK = k; camX = VW / 2 - x * k; camY = VH / 2 - y * k; flight = null; return; }
    flight = { from: [cx, cy, camK], to: at, k, start: performance.now() };
  }

  // ---- LOD, from how big each system is on screen right now ----
  function applyLOD() {
    const fm = frameMin();
    const px = (n: number) => (n * unitsPerPx()) / camK;
    camera.setAttribute('transform', `translate(${camX.toFixed(2)},${camY.toFixed(2)}) scale(${camK.toFixed(5)})`);

    $('topicLabels').style.fontSize = `${px(13)}px`;
    $('topicLabels').style.strokeWidth = `${px(4)}px`;
    $('clusterLabels').style.fontSize = `${px(11.5)}px`;
    $('clusterLabels').style.strokeWidth = `${px(3.5)}px`;
    $('clusters').style.fontSize = `${px(10)}px`;
    $('clusters').style.strokeWidth = `${px(3)}px`;
    const ms = String(Math.min(1, px(2.2)));
    for (const g of ['clusters', 'bridgeLayer', 'coreLayer']) $(g).style.setProperty('--ms', ms);
    $('bridgeLayer').style.fontSize = `${px(9.5)}px`;
    $('bridgeLayer').style.strokeWidth = `${px(3)}px`;
    $('coreLayer').style.fontSize = `${px(11)}px`;
    $('coreLayer').style.strokeWidth = `${px(3.5)}px`;
    topicOrbit.setAttribute('stroke-width', String(px(1)));

    for (const t of topics) {
      const sr = screenR(t.size);
      const { halo, label } = topicEls.get(t.data.id)!;
      halo.setAttribute('cx', t.x.toFixed(1)); halo.setAttribute('cy', t.y.toFixed(1));
      const inside = band(sr, fm * 0.22, fm * 0.4);
      halo.style.opacity = String(1 - 0.75 * inside);
      halo.style.pointerEvents = inside < 0.5 ? '' : 'none';
      label.setAttribute('transform', `translate(${t.x.toFixed(1)},${t.y.toFixed(1)})`);
      label.style.opacity = String(1 - inside);
      for (const c of t.clusters) {
        const cr = screenR(c.size);
        const { halo: ch, label: cl, group, bodies, dyads } = clusterEls.get(c.data.id)!;
        const shown = band(sr, fm * 0.16, fm * 0.3);
        const within = band(cr, fm * 0.2, fm * 0.36);
        ch.setAttribute('cx', c.x.toFixed(1)); ch.setAttribute('cy', c.y.toFixed(1));
        ch.style.opacity = String(shown * (1 - 0.6 * within));
        ch.style.pointerEvents = shown > 0.5 && within < 0.5 ? '' : 'none';
        cl.setAttribute('x', c.x.toFixed(1)); cl.setAttribute('y', (c.y - c.size - px(6)).toFixed(1));
        cl.style.opacity = String(shown * (1 - within));
        // bodies are faint texture from afar, then resolve into stars inside their cluster
        group.style.opacity = String(0.25 + 0.75 * band(cr, 20, 70));
        group.style.pointerEvents = cr > 60 ? '' : 'none';
        group.style.setProperty('--lbl', String(band(cr, fm * 0.18, fm * 0.3)));
        const dyadVis = band(cr, 50, 130);
        for (const [id, a] of bodies) { const p = bodyPos.get(id)!; a.setAttribute('transform', `translate(${p[0].toFixed(2)},${p[1].toFixed(2)})`); }
        if (dyadVis > 0) for (const d of dyads) {
          const p = bodyPos.get(d.a)!, q = bodyPos.get(d.b)!;
          d.line.setAttribute('x1', p[0].toFixed(2)); d.line.setAttribute('y1', p[1].toFixed(2));
          d.line.setAttribute('x2', q[0].toFixed(2)); d.line.setAttribute('y2', q[1].toFixed(2));
        }
        (dyads[0]?.line.parentNode as SVGGElement | undefined)?.style.setProperty('opacity', String(dyadVis));
      }
    }
    const nearTopics = Math.max(...topics.map((t) => screenR(t.size)));
    const bridgeVis = 0.35 + 0.65 * band(nearTopics, fm * 0.2, fm * 0.4);
    $('bridgeLayer').style.opacity = String(bridgeVis);
    $('bridgeLayer').style.setProperty('--blbl', String(band(nearTopics, fm * 0.5, fm * 0.9)));
    for (const [id, a] of bridgeEls) { const p = bodyPos.get(id)!; a.setAttribute('transform', `translate(${p[0].toFixed(2)},${p[1].toFixed(2)})`); }
    for (const { data, a } of companionEls) { const p = bodyPos.get(data.id)!; a.setAttribute('transform', `translate(${p[0].toFixed(2)},${p[1].toFixed(2)})`); }
    coreG.style.setProperty('--lbl', String(band(screenR(40), 30, 80)));
    (coreBody as unknown as SVGElement).style.setProperty('--lbl', '1');
    $('dust').style.opacity = String(1 - band(screenR(galaxyRadius), fm * 1.5, fm * 4));
    updateCrumbs();
  }

  // ---- the frame loop ----
  function frame(now: number) {
    const dt = Math.min(0.1, (now - lastNow) / 1000);
    lastNow = now;
    if (!paused && !reduced) clock += dt;
    place();
    if (flight) {
      const t = Math.min(1, (now - flight.start) / 900);
      const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      const [tx, ty] = flight.to();
      const x = flight.from[0] + (tx - flight.from[0]) * e, y = flight.from[1] + (ty - flight.from[1]) * e;
      camK = Math.exp(Math.log(flight.from[2]) + (Math.log(flight.k) - Math.log(flight.from[2])) * e);
      camX = VW / 2 - x * camK; camY = VH / 2 - y * camK;
      if (t >= 1) flight = null;
    } else if (focus && focus.kind !== 'cosmos') {
      // follow what you flew to, so it doesn't drift out from under you
      const [x, y] = focusTarget(focus).at();
      camX = VW / 2 - x * camK; camY = VH / 2 - y * camK;
    }
    applyLOD();
    requestAnimationFrame(frame);
  }

  // ---- where you are ----
  let lastCrumbs = '';
  function updateCrumbs() {
    const cx = (VW / 2 - camX) / camK, cy = (VH / 2 - camY) / camK, fm = frameMin();
    const parts: { label: string; go: () => void }[] = [{ label: 'Cosmos', go: () => { unpin(); flyTo({ kind: 'cosmos' }); } }];
    const nearest = <T extends { x: number; y: number }>(list: T[]) => list.reduce((b, t) => (Math.hypot(t.x - cx, t.y - cy) < Math.hypot(b.x - cx, b.y - cy) ? t : b));
    const t = nearest(topics);
    if (screenR(t.size) > fm * 0.3) {
      parts.push({ label: t.data.name, go: () => { unpin(); flyTo({ kind: 'topic', id: t.data.id }); } });
      const c = nearest(t.clusters);
      if (screenR(c.size) > fm * 0.25) {
        parts.push({ label: c.data.name, go: () => { unpin(); flyTo({ kind: 'cluster', id: c.data.id }); } });
        if (focus?.kind === 'body' && clusterOfBody.get(focus.id) === c) {
          const id = focus.id;
          parts.push({ label: G.bodies[id].title, go: () => flyTo({ kind: 'body', id }) });
        }
      }
    }
    const key = parts.map((p) => p.label).join('|');
    if (key === lastCrumbs) return;
    lastCrumbs = key;
    crumbBar.replaceChildren();
    parts.forEach((p, i) => {
      if (i) { const s = document.createElement('span'); s.className = 'crumb-sep'; s.textContent = '›'; crumbBar.appendChild(s); }
      if (i === parts.length - 1) { const s = document.createElement('span'); s.className = 'crumb-current'; s.textContent = p.label; crumbBar.appendChild(s); }
      else { const b = document.createElement('button'); b.type = 'button'; b.textContent = p.label; b.addEventListener('click', p.go); crumbBar.appendChild(b); }
    });
  }

  // ---- cards: hovering pauses the orbits; a focused body keeps its card pinned ----
  let pinned: string | null = null;
  const show = (html: string) => { if (pinned) return; nodeCard.hidden = false; nodeCard.innerHTML = html; };
  const hide = () => { if (pinned) return; nodeCard.hidden = true; paused = false; };
  function unpin() { pinned = null; nodeCard.classList.remove('pinned'); nodeCard.hidden = true; document.querySelectorAll('.body.focus').forEach((b) => b.classList.remove('focus')); paused = false; }
  const topicName = (id?: string) => (id ? topicById.get(id)?.data.name : '') ?? '';
  function bodyCard(id: string, b: { kind: Kind; title: string; blurb: string; bridge?: [string, string]; topic?: string }, withOpen: boolean) {
    const where = b.bridge ? `Between ${esc(topicName(b.bridge[0]))} and ${esc(topicName(b.bridge[1]))}` : b.topic ? esc(topicName(b.topic)) : 'The center';
    return `<div class="nc-part">${KIND_LABEL[b.kind]} · ${where}</div><div class="nc-title">${esc(b.title)}</div>${b.blurb ? `<div class="nc-sub">${esc(b.blurb)}</div>` : ''}${withOpen ? `<a class="nc-open" href="${esc((G.bodies[id] ?? { href: '' }).href || (id === G.core.id ? G.core.href : G.core.companions.find((c) => c.id === id)?.href ?? ''))}">Open →</a>` : ''}`;
  }

  let dragMoved = false;
  for (const t of topics) {
    const { halo } = topicEls.get(t.data.id)!;
    halo.addEventListener('pointerenter', () => {
      paused = true; halo.classList.add('hot');
      show(`<div class="nc-part">Topic · ${t.clusters.length} clusters · ${t.count} bodies</div><div class="nc-title">${esc(t.data.name)}</div><div class="nc-sub">${t.clusters.slice(0, 5).map((c) => esc(c.data.name)).join(' · ')}</div>`);
    });
    halo.addEventListener('pointerleave', () => { halo.classList.remove('hot'); hide(); });
    halo.addEventListener('click', () => { if (!dragMoved) { unpin(); flyTo({ kind: 'topic', id: t.data.id }); } });
  }
  for (const c of clusterById.values()) {
    const { halo, bodies } = clusterEls.get(c.data.id)!;
    halo.addEventListener('pointerenter', () => {
      paused = true; halo.classList.add('hot');
      const titles = c.data.bodies.slice(0, 6).map((b) => esc(G.bodies[b].title)).join(' · ');
      show(`<div class="nc-part">Cluster in ${esc(c.topic.data.name)} · ${c.data.bodies.length} bodies</div><div class="nc-title">${esc(c.data.name)}</div><div class="nc-sub">${titles}${c.data.bodies.length > 6 ? ' …' : ''}</div>`);
    });
    halo.addEventListener('pointerleave', () => { halo.classList.remove('hot'); hide(); });
    halo.addEventListener('click', () => { if (!dragMoved) { unpin(); flyTo({ kind: 'cluster', id: c.data.id }); } });
    for (const [id, a] of bodies) wireBody(id, a, () => G.bodies[id]);
  }
  for (const [id, a] of bridgeEls) wireBody(id, a, () => G.bodies[id]);
  wireBody(G.core.id, coreBody, () => ({ kind: 'page' as Kind, title: G.core.title, blurb: G.core.blurb }));
  for (const { data, a } of companionEls) wireBody(data.id, a, () => ({ kind: data.kind, title: data.title, blurb: data.blurb }));

  function wireBody(id: string, a: SVGAElement, info: () => { kind: Kind; title: string; blurb: string; bridge?: [string, string]; topic?: string }) {
    a.addEventListener('pointerenter', () => {
      paused = true; a.classList.add('hot');
      const cl = clusterOfBody.get(id);
      if (cl) for (const d of clusterEls.get(cl.data.id)!.dyads) d.line.classList.toggle('hot', d.a === id || d.b === id);
      show(bodyCard(id, info(), false));
    });
    a.addEventListener('pointerleave', () => {
      a.classList.remove('hot');
      const cl = clusterOfBody.get(id);
      if (cl) for (const d of clusterEls.get(cl.data.id)!.dyads) d.line.classList.remove('hot');
      hide();
      if (pinned) paused = true;
    });
    a.addEventListener('click', (e) => {
      if (dragMoved) { e.preventDefault(); return; }
      if (pinned === id) return; // second click follows the link
      e.preventDefault();
      unpin();
      pinned = id;
      a.classList.add('focus');
      paused = true;
      nodeCard.hidden = false;
      nodeCard.classList.add('pinned');
      nodeCard.innerHTML = bodyCard(id, info(), true);
      flyTo({ kind: 'body', id });
    });
  }

  // ---- pan, wheel, pinch ----
  const pointers = new Map<number, { x: number; y: number }>();
  let pinch = 0;
  const breakFollow = () => { flight = null; if (focus && focus.kind !== 'cosmos') focus = null; };
  svg.addEventListener('pointerdown', (e) => {
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    dragMoved = false;
    if (pointers.size === 2) { const [p, q] = [...pointers.values()]; pinch = Math.hypot(p.x - q.x, p.y - q.y); }
    svg.classList.add('dragging');
  });
  svg.addEventListener('pointermove', (e) => {
    const prev = pointers.get(e.pointerId);
    if (!prev) return;
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pointers.size === 2) {
      const [p, q] = [...pointers.values()];
      const d = Math.hypot(p.x - q.x, p.y - q.y);
      if (pinch) zoomAt((p.x + q.x) / 2, (p.y + q.y) / 2, d / pinch);
      pinch = d;
      return;
    }
    const dx = e.clientX - prev.x, dy = e.clientY - prev.y;
    if (Math.abs(dx) + Math.abs(dy) > 3) {
      if (!dragMoved) { svg.setPointerCapture(e.pointerId); breakFollow(); }
      dragMoved = true;
    }
    if (dragMoved) { const u = unitsPerPx(); camX += dx * u; camY += dy * u; }
  });
  const endPointer = (e: PointerEvent) => { pointers.delete(e.pointerId); if (pointers.size < 2) pinch = 0; if (!pointers.size) svg.classList.remove('dragging'); };
  svg.addEventListener('pointerup', endPointer);
  svg.addEventListener('pointercancel', endPointer);

  function zoomAt(clientX: number, clientY: number, factor: number) {
    const rect = svg.getBoundingClientRect();
    const mx = (clientX - rect.left) * (VW / rect.width), my = (clientY - rect.top) * (VH / rect.height);
    const nk = Math.max(k0 * 0.6, Math.min(k0 * 90, camK * factor));
    const f = nk / camK;
    breakFollow();
    camX = mx * (1 - f) + camX * f; camY = my * (1 - f) + camY * f; camK = nk;
  }
  svg.addEventListener('wheel', (e) => {
    e.preventDefault();
    const dy = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaMode === 2 ? e.deltaY * 400 : e.deltaY;
    zoomAt(e.clientX, e.clientY, Math.max(0.75, Math.min(1.33, Math.exp(-dy * 0.0018))));
  }, { passive: false });
  const centerZoom = (f: number) => { const r = svg.getBoundingClientRect(); zoomAt(r.left + r.width / 2, r.top + r.height / 2, f); };
  $('zoom-in').addEventListener('click', () => centerZoom(1.4));
  $('zoom-out').addEventListener('click', () => centerZoom(1 / 1.4));
  $('zoom-reset').addEventListener('click', () => { unpin(); flyTo({ kind: 'cosmos' }); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && pinned) unpin(); });

  // ---- start at the whole Cosmos ----
  place();
  k0 = kFor(galaxyRadius);
  camK = k0; camX = VW / 2; camY = VH / 2;
  new ResizeObserver(() => {
    const cx = (VW / 2 - camX) / camK, cy = (VH / 2 - camY) / camK;
    const ratio = camK / k0;
    syncViewBox();
    k0 = kFor(galaxyRadius);
    camK = k0 * ratio; camX = VW / 2 - cx * camK; camY = VH / 2 - cy * camK;
  }).observe(svg);

  const lit = [...visited].filter((s) => G.bodies[`c:${s}`] || G.bodies[`p:${s}`]).length;
  if (lit) $('thread-count').textContent = `Your thread so far: ${lit} lit. `;
  requestAnimationFrame(frame);
</script>
