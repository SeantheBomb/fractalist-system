---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { PARTS } from '../../scripts/manifest.mjs';

const nodesC = await getCollection('nodes');
const thirdsC = await getCollection('thirds');

interface MapNode {
  id: string; href: string; title: string; group: string; color: string; related: string[];
}

const items: MapNode[] = [
  ...nodesC.map((n) => ({
    id: n.id, href: `/node/${n.id}/`, title: n.data.title, group: n.data.part,
    color: PARTS[n.data.part]?.color ?? 'var(--muted)',
    related: n.data.related,
  })),
  ...thirdsC.map((t) => ({
    id: t.id, href: `/thirds/${t.id}/`, title: t.data.name, group: 'thirds',
    color: 'var(--c-p5)',
    related: [...t.data.relatedThirds, ...t.data.relatedNodes],
  })),
];

const byId = new Map(items.map((n) => [n.id, n]));

// Unique undirected edges — this is the whole graph's gravity.
const edgeSet = new Set<string>();
const edges: [string, string][] = [];
for (const n of items) for (const r of n.related) {
  if (!byId.has(r)) continue;
  const key = [n.id, r].sort().join('|');
  if (edgeSet.has(key)) continue;
  edgeSet.add(key);
  edges.push(key.split('|') as [string, string]);
}

// Degree — a note's mass. More connections, more gravity, more visual weight.
const degree = new Map<string, number>();
for (const n of items) degree.set(n.id, 0);
for (const [a, b] of edges) {
  degree.set(a, (degree.get(a) ?? 0) + 1);
  degree.set(b, (degree.get(b) ?? 0) + 1);
}

// A Skein is not everything reachable by some path — a single incidental cross-reference
// would then merge the whole book into one blob. A Skein is where connections are genuinely
// DENSE relative to the rest of the graph: Louvain modularity maximization, run here at two
// resolutions — once coarse for Cultures, then again inside each Culture, finer, for the
// Skeins that actually make it up.
function louvain(nodeIds: string[], rawEdges: [string, string][], resolution = 1): Map<string, string> {
  type Edge = [string, string, number];
  let curNodes: string[] = nodeIds.slice();
  let curEdges: Edge[] = rawEdges.map(([a, b]) => [a, b, 1]);
  const levels: Map<string, string>[] = [];

  for (let level = 0; level < 12; level++) {
    const adj = new Map<string, Map<string, number>>();
    for (const n of curNodes) adj.set(n, new Map());
    for (const [a, b, w] of curEdges) {
      if (a === b) { adj.get(a)!.set(a, (adj.get(a)!.get(a) ?? 0) + w * 2); continue; }
      adj.get(a)!.set(b, (adj.get(a)!.get(b) ?? 0) + w);
      adj.get(b)!.set(a, (adj.get(b)!.get(a) ?? 0) + w);
    }
    const degreeOf = new Map<string, number>();
    let m2 = 0;
    for (const n of curNodes) {
      let d = 0;
      for (const w of adj.get(n)!.values()) d += w;
      degreeOf.set(n, d);
      m2 += d;
    }
    if (m2 === 0) break;

    const comm = new Map<string, string>(curNodes.map((n) => [n, n]));
    const commTot = new Map<string, number>(curNodes.map((n) => [n, degreeOf.get(n)!]));

    let anyMoveEver = false;
    for (let pass = 0, improved = true; improved && pass < 50; pass++) {
      improved = false;
      for (const n of curNodes) {
        const nDeg = degreeOf.get(n)!;
        const curC = comm.get(n)!;
        commTot.set(curC, commTot.get(curC)! - nDeg);
        const neighborW = new Map<string, number>();
        for (const [nb, w] of adj.get(n)!) {
          if (nb === n) continue;
          const c = comm.get(nb)!;
          neighborW.set(c, (neighborW.get(c) ?? 0) + w);
        }
        const gainFor = (c: string) => (neighborW.get(c) ?? 0) - resolution * (nDeg * (commTot.get(c) ?? 0)) / m2;
        let bestC = curC, bestGain = gainFor(curC);
        for (const c of neighborW.keys()) {
          const g = gainFor(c);
          if (g > bestGain + 1e-9) { bestGain = g; bestC = c; }
        }
        commTot.set(bestC, (commTot.get(bestC) ?? 0) + nDeg);
        if (bestC !== curC) { comm.set(n, bestC); improved = true; anyMoveEver = true; }
      }
    }

    levels.push(new Map(comm));
    const uniqueComms = new Set(comm.values());
    if (!anyMoveEver || uniqueComms.size === curNodes.length) break;

    const edgeWeight = new Map<string, number>();
    for (const [a, b, w] of curEdges) {
      const ca = comm.get(a)!, cb = comm.get(b)!;
      const key = ca <= cb ? `${ca}|${cb}` : `${cb}|${ca}`;
      edgeWeight.set(key, (edgeWeight.get(key) ?? 0) + w);
    }
    curNodes = Array.from(uniqueComms);
    curEdges = Array.from(edgeWeight.entries()).map(([k, w]): Edge => {
      const [a, b] = k.split('|');
      return [a, b, w];
    });
  }

  const finalComm = new Map<string, string>();
  for (const orig of nodeIds) {
    let cur = orig;
    for (const lvl of levels) cur = lvl.get(cur) ?? cur;
    finalComm.set(orig, cur);
  }
  return finalComm;
}

function dominant(ids: string[]): { label: string; color: string; group: string } {
  const counts = new Map<string, number>();
  for (const id of ids) {
    const g = byId.get(id)!.group;
    counts.set(g, (counts.get(g) ?? 0) + 1);
  }
  const group = Array.from(counts.entries()).sort((a, b) => b[1] - a[1])[0][0];
  const label = group === 'thirds' ? 'The Standing Thirds' : (PARTS[group]?.title.replace(/ — .*$/, '') ?? group);
  const color = group === 'thirds' ? 'var(--c-p5)' : (PARTS[group]?.color ?? 'var(--muted)');
  return { label, color, group };
}
function anchorTitle(ids: string[]): string {
  const best = ids.reduce((a, b) => ((degree.get(b) ?? 0) > (degree.get(a) ?? 0) ? b : a));
  return byId.get(best)!.title;
}

// ---- Cultures: the coarse pass over the whole graph ----
const cultureOf = louvain(items.map((n) => n.id), edges, 1);
const cultureMembers = new Map<string, string[]>();
for (const n of items) {
  const c = cultureOf.get(n.id)!;
  if (!cultureMembers.has(c)) cultureMembers.set(c, []);
  cultureMembers.get(c)!.push(n.id);
}
const cultures = Array.from(cultureMembers.entries()).map(([id, noteIds], i) => {
  const d = dominant(noteIds);
  return { id: `culture-${i}`, rawId: id, noteIds, label: d.label, color: d.color, anchor: anchorTitle(noteIds) };
});
const cultureIdOf = new Map<string, string>(); // note -> culture-N
for (const c of cultures) for (const id of c.noteIds) cultureIdOf.set(id, c.id);

// ---- Skeins: a finer pass INSIDE each Culture, so a Skein is never split across Cultures ----
const noteIdSet = new Set(items.map((n) => n.id));
let skeinCounter = 0;
const skeinIdOf = new Map<string, string>(); // note -> skein-N
const skeins: { id: string; cultureId: string; noteIds: string[]; label: string; color: string; anchor: string }[] = [];
for (const culture of cultures) {
  const subSet = new Set(culture.noteIds);
  const subEdges = edges.filter(([a, b]) => subSet.has(a) && subSet.has(b));
  let subComm: Map<string, string>;
  if (culture.noteIds.length >= 4 && subEdges.length >= 2) {
    subComm = louvain(culture.noteIds, subEdges, 1.6);
  } else {
    subComm = new Map(culture.noteIds.map((id) => [id, 'solo']));
  }
  const groups = new Map<string, string[]>();
  for (const id of culture.noteIds) {
    const g = subComm.get(id) ?? 'solo';
    if (!groups.has(g)) groups.set(g, []);
    groups.get(g)!.push(id);
  }
  for (const noteIds of groups.values()) {
    const id = `skein-${skeinCounter++}`;
    for (const nid of noteIds) skeinIdOf.set(nid, id);
    const d = dominant(noteIds);
    skeins.push({ id, cultureId: culture.id, noteIds, label: d.label, color: d.color, anchor: anchorTitle(noteIds) });
  }
}

// ---- adjacency, for "related X on the outskirts" at each level ----
function adjacency(idOf: Map<string, string>): Map<string, Set<string>> {
  const adj = new Map<string, Set<string>>();
  for (const [a, b] of edges) {
    const ca = idOf.get(a)!, cb = idOf.get(b)!;
    if (ca === cb) continue;
    if (!adj.has(ca)) adj.set(ca, new Set());
    if (!adj.has(cb)) adj.set(cb, new Set());
    adj.get(ca)!.add(cb);
    adj.get(cb)!.add(ca);
  }
  return adj;
}
const cultureAdj = adjacency(cultureIdOf);
const skeinAdj = adjacency(skeinIdOf);

const graphData = {
  items: items.map((n) => ({
    id: n.id, href: n.href, title: n.title, group: n.group, color: n.color,
    degree: degree.get(n.id) ?? 0, skeinId: skeinIdOf.get(n.id)!, cultureId: cultureIdOf.get(n.id)!,
  })),
  edges,
  cultures: cultures.map((c) => ({
    id: c.id, label: c.label, color: c.color, anchor: c.anchor, noteIds: c.noteIds,
    skeinIds: skeins.filter((s) => s.cultureId === c.id).map((s) => s.id),
    adj: Array.from(cultureAdj.get(c.id) ?? []),
  })),
  skeins: skeins.map((s) => ({
    id: s.id, cultureId: s.cultureId, label: s.label, color: s.color, anchor: s.anchor, noteIds: s.noteIds,
    adj: Array.from(skeinAdj.get(s.id) ?? []),
  })),
};
---
<Base title="The Map" description="Every topic in Fractalism as a star map — one continuous space, from the whole Cosmos down to a single note, held together by nothing but its own gravity." wide>
  <h1>The Map</h1>
  <p style="max-width: 44rem; color: var(--muted);">
    This is the Infinite Boundary, sketched — every idea here, held together by nothing but its own
    gravity. From far out you see the Cultures. Come closer and the Skeins inside them resolve; closer
    still and the notes themselves light up, with the Dyads between them. Nothing was placed by hand —
    the shape is what's left once every real connection is allowed to pull, and everything else is
    allowed to push away.
  </p>

  <div class="crumb-bar" id="crumb-bar" role="navigation" aria-label="Where you are"></div>

  <div class="map-frame">
    <svg id="graph" viewBox="0 0 1100 860" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id="nebula" x="-40%" y="-40%" width="180%" height="180%">
          <feGaussianBlur stdDeviation="12" />
        </filter>
        <filter id="nebula-soft" x="-40%" y="-40%" width="180%" height="180%">
          <feGaussianBlur stdDeviation="22" />
        </filter>
      </defs>
      <g id="camera">
        <g id="dust"></g>
        <g id="cultureHulls"></g>
        <g id="skeinHulls"></g>
        <g id="edgeLayer"></g>
        <g id="noteLayer"></g>
        <g id="skeinLabels"></g>
        <g id="cultureLabels"></g>
      </g>
    </svg>
    <div class="vignette" aria-hidden="true"></div>
    <div class="map-controls">
      <button id="zoom-in" type="button" aria-label="Zoom in">+</button>
      <button id="zoom-out" type="button" aria-label="Zoom out">−</button>
      <button id="zoom-reset" type="button" aria-label="Back to the whole Cosmos">⟲</button>
    </div>
    <div id="node-card" class="node-card" hidden></div>
  </div>

  <p class="map-legend">
    <span id="thread-count"></span>
    Drag to pan, scroll or pinch to zoom, click anything to fly to it. When a note is close enough to
    read, clicking it opens it.
    Prefer a list? <a href="/book/">The Book</a> holds everything in printed order, and the
    <a href="/thirds/">Thirds gallery</a> holds the mythology.
  </p>

  <script type="application/json" id="graph-data" set:html={JSON.stringify(graphData).replace(/</g, '\\u003c')} />
</Base>

<style is:global>
  .crumb-bar {
    display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;
    margin-top: 1.5rem; font-family: var(--sans); font-size: 0.85rem; min-height: 1.6rem;
  }
  .crumb-bar button {
    font: inherit; background: none; border: none; color: var(--muted); cursor: pointer;
    padding: 0.15rem 0.3rem; border-radius: 6px;
  }
  .crumb-bar button:hover { color: var(--accent); background: var(--bg2); }
  .crumb-bar .crumb-current { color: var(--ink); font-weight: 600; padding: 0.15rem 0.3rem; }
  .crumb-bar .crumb-sep { color: var(--line); }

  .map-frame {
    position: relative; border: 1px solid var(--line); border-radius: 14px;
    background: var(--bg2); margin-top: 0.75rem; overflow: hidden;
  }
  #graph { display: block; width: 100%; height: min(78vh, 720px); touch-action: none; cursor: grab; }
  #graph.dragging { cursor: grabbing; }
  .vignette {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 52%, color-mix(in srgb, var(--ink) 10%, transparent) 100%);
  }

  /* background dust: depth without meaning */
  #dust circle { fill: var(--muted); }
  #dust circle.tw { animation: dust-twinkle 5s ease-in-out infinite; }
  @keyframes dust-twinkle { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }

  /* nebulae */
  #cultureHulls path { filter: url(#nebula-soft); stroke-linejoin: round; stroke-linecap: round; transition: fill-opacity 0.2s ease, stroke-opacity 0.2s ease; }
  #skeinHulls path { filter: url(#nebula); stroke-linejoin: round; stroke-linecap: round; transition: fill-opacity 0.2s ease, stroke-opacity 0.2s ease; }
  #cultureHulls path.hot, #skeinHulls path.hot { fill-opacity: 0.26 !important; stroke-opacity: 0.4 !important; }
  #cultureHulls path, #skeinHulls path { cursor: pointer; }

  /* dyads */
  #edgeLayer .dyad { stroke: var(--muted); stroke-width: 1; vector-effect: non-scaling-stroke; opacity: 0.45; transition: opacity 0.12s ease, stroke 0.12s ease; }
  #edgeLayer .dyad-hit { stroke: transparent; stroke-width: 14; vector-effect: non-scaling-stroke; cursor: pointer; }
  #edgeLayer .dyad.hot { stroke: var(--accent); opacity: 1; stroke-width: 2; }
  #edgeLayer .dyad.dim { opacity: 0.06; }

  /* stars */
  .gnode { cursor: pointer; }
  .gnode circle { transition: opacity 0.15s ease; }
  .gnode.visited circle { filter: drop-shadow(0 0 3px currentColor); }
  .gnode text {
    font-family: var(--sans); fill: var(--ink); text-anchor: middle; pointer-events: none;
    paint-order: stroke; stroke: var(--bg2); stroke-linejoin: round;
    opacity: var(--lbl, 0); transition: opacity 0.15s ease;
  }
  .gnode.hot circle { opacity: 1 !important; filter: drop-shadow(0 0 5px currentColor); }
  .gnode.hot text { opacity: 1; font-weight: 600; }
  .gnode.dim circle { opacity: 0.12 !important; }
  .gnode.dim text { opacity: 0 !important; }

  /* region labels */
  #cultureLabels text, #skeinLabels text {
    font-family: var(--sans); text-anchor: middle; pointer-events: none;
    paint-order: stroke; stroke: var(--bg2); stroke-linejoin: round; fill: var(--ink);
  }
  #cultureLabels text { font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  #cultureLabels text .sub { font-weight: 400; letter-spacing: 0; text-transform: none; font-size: 0.8em; fill: color-mix(in srgb, var(--ink) 70%, var(--muted)); }
  #graph.narrow #cultureLabels text .sub { display: none; }
  #skeinLabels text { font-weight: 500; fill: color-mix(in srgb, var(--ink) 80%, var(--muted)); }

  .map-controls { position: absolute; right: 0.75rem; bottom: 0.75rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .map-controls button {
    width: 30px; height: 30px; border-radius: 8px; border: 1px solid var(--line);
    background: var(--bg); color: var(--ink); font-size: 1rem; line-height: 1; cursor: pointer;
  }
  .map-controls button:hover { border-color: var(--accent); }

  .node-card {
    position: absolute; left: 0.85rem; top: 0.85rem; max-width: 16rem;
    background: var(--bg); border: 1px solid var(--line); border-radius: 10px;
    padding: 0.6rem 0.8rem; font-family: var(--sans); font-size: 0.78rem; pointer-events: none;
  }
  .node-card .nc-part { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .node-card .nc-title { font-family: var(--serif); font-size: 1rem; margin-top: 0.15rem; color: var(--ink); }
  .node-card .nc-sub { margin-top: 0.3rem; color: var(--muted); }

  .map-legend { font-family: var(--sans); font-size: 0.85rem; color: var(--muted); margin-top: 1rem; }

  @media (prefers-reduced-motion: reduce) { #dust circle.tw { animation: none; } }
</style>

<script>
  import { forceSimulation, forceManyBody, forceLink, forceCollide, forceCenter } from 'd3-force';

  interface Note { id: string; href: string; title: string; group: string; color: string; degree: number; skeinId: string; cultureId: string; r: number; x?: number; y?: number; }
  interface Region { id: string; label: string; color: string; anchor: string; noteIds: string[]; cultureId?: string; skeinIds?: string[]; x: number; y: number; }

  const data = JSON.parse(document.getElementById('graph-data')!.textContent || '{}') as {
    items: Omit<Note, 'r'>[]; edges: [string, string][];
    cultures: { id: string; label: string; color: string; anchor: string; noteIds: string[]; skeinIds: string[] }[];
    skeins: { id: string; cultureId: string; label: string; color: string; anchor: string; noteIds: string[] }[];
  };

  const notes: Note[] = data.items.map((n) => ({ ...n, r: n.degree === 0 ? 3.2 : 4 + Math.min(11, Math.sqrt(n.degree) * 3.4) }));
  const noteById = new Map(notes.map((n) => [n.id, n]));
  const cultures: Region[] = data.cultures.map((c) => ({ ...c, x: 0, y: 0 }));
  const skeins: Region[] = data.skeins.map((s) => ({ ...s, x: 0, y: 0 }));
  const cultureById = new Map(cultures.map((c) => [c.id, c]));
  const skeinById = new Map(skeins.map((s) => [s.id, s]));

  const svg = document.getElementById('graph') as unknown as SVGSVGElement;
  const camera = document.getElementById('camera')!;
  const dustG = document.getElementById('dust')!;
  const cultureHullG = document.getElementById('cultureHulls')!;
  const skeinHullG = document.getElementById('skeinHulls')!;
  const edgeG = document.getElementById('edgeLayer')!;
  const noteG = document.getElementById('noteLayer')!;
  const skeinLabelG = document.getElementById('skeinLabels')!;
  const cultureLabelG = document.getElementById('cultureLabels')!;
  const nodeCard = document.getElementById('node-card') as HTMLDivElement;
  const crumbBar = document.getElementById('crumb-bar')!;
  const NS = 'http://www.w3.org/2000/svg';
  // the viewBox follows the frame's real aspect, so a tall phone never letterboxes the galaxy
  let VW = 1100, VH = 860;
  function syncViewBox() {
    const r = svg.getBoundingClientRect();
    if (r.width > 0 && r.height > 0) VH = Math.round(VW * (r.height / r.width));
    svg.setAttribute('viewBox', `0 0 ${VW} ${VH}`);
  }
  syncViewBox();
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const band = (v: number, a: number, b: number) => { if (v <= a) return 0; if (v >= b) return 1; const t = (v - a) / (b - a); return t * t * (3 - 2 * t); };
  const rgbaOf = (cssColor: string) => cssColor; // colors are CSS vars; opacity is applied via fill-opacity/stroke-opacity

  // ---- physics: the single layout every scale is a view of ----
  const sim = forceSimulation(notes as any)
    .force('charge', forceManyBody().strength((d: any) => (d.degree === 0 ? -650 : -50 - d.degree * 16)))
    .force('link', forceLink(data.edges.map(([a, b]) => ({ source: a, target: b })) as any).id((d: any) => d.id).distance((d: any) => 30 + (d.source.r ?? 5) + (d.target.r ?? 5)).strength(0.55))
    .force('collide', forceCollide().radius((d: any) => d.r + 4).strength(0.85).iterations(2))
    .force('center', forceCenter(0, 0))
    .alphaDecay(reduced ? 1 : 0.02);

  // ---- background dust: seeded, meaningless, purely for depth ----
  (function seedDust() {
    let s = 20260824;
    const rnd = () => { s = (s * 1664525 + 1013904223) >>> 0; return s / 4294967296; };
    for (let i = 0; i < 520; i++) {
      const ang = rnd() * Math.PI * 2;
      const rad = 120 + Math.pow(rnd(), 0.6) * 1100;
      const c = document.createElementNS(NS, 'circle');
      c.setAttribute('cx', (Math.cos(ang) * rad).toFixed(1));
      c.setAttribute('cy', (Math.sin(ang) * rad * 0.85).toFixed(1));
      c.setAttribute('r', (0.5 + rnd() * 0.9).toFixed(2));
      c.setAttribute('opacity', (0.12 + rnd() * 0.22).toFixed(2));
      if (rnd() < 0.22) { c.setAttribute('class', 'tw'); c.style.animationDelay = `${(rnd() * 5).toFixed(2)}s`; }
      dustG.appendChild(c);
    }
  })();

  // ---- DOM ----
  const noteEls = new Map<string, { g: SVGAElement; c: SVGCircleElement; t: SVGTextElement }>();
  for (const n of notes) {
    const g = document.createElementNS(NS, 'a') as unknown as SVGAElement;
    g.setAttribute('href', n.href); g.setAttribute('class', 'gnode'); g.dataset.id = n.id;
    const c = document.createElementNS(NS, 'circle');
    c.setAttribute('style', `fill:${n.color}`);
    const t = document.createElementNS(NS, 'text');
    t.textContent = n.title;
    g.appendChild(c); g.appendChild(t);
    noteG.appendChild(g);
    noteEls.set(n.id, { g, c, t });
  }
  const edgeEls = data.edges.map(([a, b]) => {
    const vis = document.createElementNS(NS, 'line'); vis.setAttribute('class', 'dyad');
    const hit = document.createElementNS(NS, 'line'); hit.setAttribute('class', 'dyad-hit');
    edgeG.appendChild(vis); edgeG.appendChild(hit);
    return { vis, hit, a, b };
  });
  function buildRegion(layerHull: Element, layerLabel: Element, r: Region, twoLine: boolean) {
    const path = document.createElementNS(NS, 'path');
    path.setAttribute('style', `fill:${r.color}; stroke:${r.color}`);
    path.dataset.id = r.id;
    layerHull.appendChild(path);
    const text = document.createElementNS(NS, 'text');
    if (twoLine) {
      const l1 = document.createElementNS(NS, 'tspan'); l1.textContent = r.label; l1.setAttribute('x', '0');
      const l2 = document.createElementNS(NS, 'tspan'); l2.textContent = `“${r.anchor}”`; l2.setAttribute('x', '0'); l2.setAttribute('dy', '1.35em'); l2.setAttribute('class', 'sub');
      text.appendChild(l1); text.appendChild(l2);
    } else {
      text.textContent = r.anchor;
    }
    layerLabel.appendChild(text);
    return { path, text };
  }
  const cultureEls = new Map(cultures.map((c) => [c.id, buildRegion(cultureHullG, cultureLabelG, c, true)]));
  const skeinEls = new Map(skeins.map((s) => [s.id, buildRegion(skeinHullG, skeinLabelG, s, false)]));

  // ---- visited thread ----
  let thread: string[] = [];
  try { thread = JSON.parse(localStorage.getItem('fractalism-thread') || '[]'); } catch {}
  const visited = new Set(thread.map((t) => t.split(':')[1]));
  let visitedCount = 0;
  for (const [id, { g }] of noteEls) if (visited.has(id)) { g.classList.add('visited'); visitedCount++; }
  const tc = document.getElementById('thread-count');
  if (tc && visitedCount > 0) tc.textContent = `Your thread so far: ${visitedCount} of ${notes.length} lit. `;
  const visitedIn = (ids: string[]) => ids.filter((id) => visited.has(id)).length;

  // ---- geometry helpers ----
  function centroid(ids: string[]): [number, number] {
    let sx = 0, sy = 0;
    for (const id of ids) { const n = noteById.get(id); sx += n?.x ?? 0; sy += n?.y ?? 0; }
    return [sx / (ids.length || 1), sy / (ids.length || 1)];
  }
  function convexHull(points: [number, number][]): [number, number][] {
    const pts = Array.from(new Set(points.map((p) => p.join(',')))).map((s) => s.split(',').map(Number) as [number, number]);
    if (pts.length < 3) return pts;
    pts.sort((a, b) => a[0] - b[0] || a[1] - b[1]);
    const cross = (o: number[], a: number[], b: number[]) => (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);
    const lower: [number, number][] = [];
    for (const p of pts) { while (lower.length >= 2 && cross(lower[lower.length - 2], lower[lower.length - 1], p) <= 0) lower.pop(); lower.push(p); }
    const upper: [number, number][] = [];
    for (let i = pts.length - 1; i >= 0; i--) { const p = pts[i]; while (upper.length >= 2 && cross(upper[upper.length - 2], upper[upper.length - 1], p) <= 0) upper.pop(); upper.push(p); }
    lower.pop(); upper.pop();
    return lower.concat(upper);
  }
  function regionPath(ids: string[], pad: number): string {
    const pts = ids.map((id) => noteById.get(id)!).filter(Boolean).map((n) => [n.x ?? 0, n.y ?? 0] as [number, number]);
    const hull = convexHull(pts);
    if (hull.length >= 3) return `M${hull.map((p) => p.join(',')).join('L')}Z`;
    const [cx, cy] = centroid(ids);
    let rad = pad;
    for (const p of pts) rad = Math.max(rad, Math.hypot(p[0] - cx, p[1] - cy) + pad * 0.6);
    return `M${cx - rad},${cy} a${rad},${rad} 0 1,0 ${rad * 2},0 a${rad},${rad} 0 1,0 ${-rad * 2},0`;
  }
  function boundsOfNotes(ids: string[]) {
    const pts = ids.map((id) => noteById.get(id)!).filter(Boolean);
    if (!pts.length) return null;
    let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
    for (const p of pts) {
      x0 = Math.min(x0, (p.x ?? 0) - p.r); x1 = Math.max(x1, (p.x ?? 0) + p.r);
      y0 = Math.min(y0, (p.y ?? 0) - p.r); y1 = Math.max(y1, (p.y ?? 0) + p.r);
    }
    return { x0, y0, x1, y1 };
  }

  // ---- camera ----
  let camX = VW / 2, camY = VH / 2, camK = 1, k0 = 1;
  let autoFit = true;
  const unitsPerPx = () => VW / svg.getBoundingClientRect().width;
  const frameWidth = () => svg.getBoundingClientRect().width;
  const padFor = (p: number) => Math.min(p, frameWidth() * 0.14);

  function applyCamera() {
    camera.setAttribute('transform', `translate(${camX.toFixed(2)},${camY.toFixed(2)}) scale(${camK.toFixed(4)})`);
    updateLOD();
    updateCrumbs();
  }

  function fitK(b: { x0: number; y0: number; x1: number; y1: number }, padPx: number) {
    const upp = unitsPerPx();
    const w = Math.max(40, b.x1 - b.x0) + padPx * upp * 2;
    const h = Math.max(40, b.y1 - b.y0) + padPx * upp * 2;
    return Math.min(VW / w, VH / h);
  }

  let animFrame = 0;
  function fitTo(b: { x0: number; y0: number; x1: number; y1: number } | null, animate = !reduced, padPx = 60, kMax = Infinity, kMin = 0) {
    if (!b) return;
    const k = Math.max(kMin, Math.min(kMax, fitK(b, padPx)));
    const cx = (b.x0 + b.x1) / 2, cy = (b.y0 + b.y1) / 2;
    const tx = VW / 2 - cx * k, ty = VH / 2 - cy * k;
    cancelAnimationFrame(animFrame);
    if (!animate) { camX = tx; camY = ty; camK = k; applyCamera(); return; }
    const sx = camX, sy = camY, sk = camK, dur = 780, start = performance.now();
    function step(now: number) {
      const t = Math.min(1, (now - start) / dur);
      const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      // interpolate zoom in log space so the fly feels even across scales
      camX = sx + (tx - sx) * e; camY = sy + (ty - sy) * e;
      camK = Math.exp(Math.log(sk) + (Math.log(k) - Math.log(sk)) * e);
      applyCamera();
      if (t < 1) animFrame = requestAnimationFrame(step);
    }
    animFrame = requestAnimationFrame(step);
  }
  function fitAll(animate: boolean) {
    const b = boundsOfNotes(notes.map((n) => n.id));
    if (!b) return;
    k0 = fitK(b, padFor(80));
    fitTo(b, animate, padFor(80));
  }
  // each flight lands inside the zoom band where its level is legible — a culture flight
  // always shows you its skeins, a skein flight always shows you readable notes
  const flyToCulture = (id: string) => { autoFit = false; fitTo(boundsOfNotes(cultureById.get(id)!.noteIds), true, padFor(70), k0 * 3.0, k0 * 2.0); };
  const flyToSkein = (id: string) => { autoFit = false; fitTo(boundsOfNotes(skeinById.get(id)!.noteIds), true, padFor(90), k0 * 6.5, k0 * 4.0); };
  new ResizeObserver(() => { syncViewBox(); if (autoFit) fitAll(false); else applyCamera(); }).observe(svg);
  const flyHome = () => { autoFit = false; fitAll(true); };

  // ---- LOD: zoom decides what's legible; nothing is ever swapped out ----
  function updateLOD() {
    const z = camK / k0;
    const upp = unitsPerPx();
    const px = (n: number) => (n * upp) / camK; // screen px -> user units at current zoom
    const narrow = frameWidth() < 600;
    svg.classList.toggle('narrow', narrow);
    const close = band(z, 1.0, 3.4);

    // stars: screen-constant sizing, brighter as you approach
    for (const n of notes) {
      const el = noteEls.get(n.id)!;
      el.c.setAttribute('r', px(n.r * (0.42 + 0.9 * close)).toFixed(2));
      el.t.setAttribute('y', px(n.r * (0.42 + 0.9 * close) + 11).toFixed(2));
    }
    noteG.style.opacity = String(0.38 + 0.62 * close);
    noteG.style.setProperty('--lbl', String(band(z, 3.0, 4.4)));
    noteG.style.fontSize = `${px(narrow ? 9 : 10)}px`;
    noteG.style.strokeWidth = `${px(3)}px`;

    edgeG.style.opacity = String(band(z, 2.0, 3.6));
    edgeG.style.pointerEvents = z >= 2.4 ? '' : 'none';

    const skeinVis = band(z, 1.35, 2.3) * (1 - band(z, 5.2, 7.5));
    skeinLabelG.style.opacity = String(band(z, 1.45, 2.05) * (1 - band(z, 4.6, 6.2)));
    skeinLabelG.style.fontSize = `${px(narrow ? 10 : 11.5)}px`;
    skeinLabelG.style.strokeWidth = `${px(3.5)}px`;
    skeinHullG.style.opacity = String(skeinVis);
    skeinHullG.style.pointerEvents = z >= 1.5 && z < 4.6 ? '' : 'none';
    for (const { path } of skeinEls.values()) { path.setAttribute('fill-opacity', '0.13'); path.setAttribute('stroke-opacity', '0.18'); path.setAttribute('stroke-width', px(26).toFixed(1)); }

    const cultureVis = 1 - 0.8 * band(z, 1.2, 2.6);
    cultureLabelG.style.opacity = String(1 - band(z, 1.25, 2.05));
    cultureLabelG.style.fontSize = `${px(narrow ? 11 : 13.5)}px`;
    cultureLabelG.style.strokeWidth = `${px(4)}px`;
    cultureHullG.style.opacity = String(cultureVis);
    cultureHullG.style.pointerEvents = z < 1.6 ? '' : 'none';
    for (const { path } of cultureEls.values()) { path.setAttribute('fill-opacity', '0.11'); path.setAttribute('stroke-opacity', '0.14'); path.setAttribute('stroke-width', px(44).toFixed(1)); }

    dustG.style.opacity = String(1 - band(z, 2.1, 3.4));
    placeLabels();
  }

  // ---- render: geometry only; runs on physics ticks ----
  function render() {
    for (const n of notes) noteEls.get(n.id)!.g.setAttribute('transform', `translate(${(n.x ?? 0).toFixed(1)},${(n.y ?? 0).toFixed(1)})`);
    for (const e of edgeEls) {
      const a = noteById.get(e.a), b = noteById.get(e.b);
      if (!a || !b) continue;
      for (const line of [e.vis, e.hit]) {
        line.setAttribute('x1', (a.x ?? 0).toFixed(1)); line.setAttribute('y1', (a.y ?? 0).toFixed(1));
        line.setAttribute('x2', (b.x ?? 0).toFixed(1)); line.setAttribute('y2', (b.y ?? 0).toFixed(1));
      }
    }
    for (const s of skeins) {
      [s.x, s.y] = centroid(s.noteIds);
      skeinEls.get(s.id)!.path.setAttribute('d', regionPath(s.noteIds, 18));
    }
    for (const c of cultures) {
      [c.x, c.y] = centroid(c.noteIds);
      cultureEls.get(c.id)!.path.setAttribute('d', regionPath(c.noteIds, 30));
    }
    placeLabels();
    if (autoFit) fitAll(false);
  }

  // Louvain communities interpenetrate in space, so their names would too — nudge labels
  // apart in screen space until none overlap. Deterministic given positions, so stable.
  function spreadLabels(pts: { x: number; y: number }[], minW: number, minH: number) {
    for (let it = 0; it < 14; it++) {
      for (let i = 0; i < pts.length; i++) for (let j = i + 1; j < pts.length; j++) {
        const a = pts[i], b = pts[j];
        const dx = b.x - a.x, dy = b.y - a.y;
        const ox = minW - Math.abs(dx), oy = minH - Math.abs(dy);
        if (ox <= 0 || oy <= 0) continue;
        if (ox / minW < oy / minH) { const s = (ox / 2 + 0.5) * (dx < 0 ? -1 : 1); a.x -= s; b.x += s; }
        else { const s = (oy / 2 + 0.5) * (dy < 0 ? -1 : 1); a.y -= s; b.y += s; }
      }
    }
    return pts;
  }
  function placeLabels() {
    const px = (n: number) => (n * unitsPerPx()) / camK;
    const narrow = frameWidth() < 600;
    const cpts = spreadLabels(cultures.map((c) => ({ x: c.x, y: c.y })), px(narrow ? 135 : 170), px(narrow ? 36 : 44));
    cultures.forEach((c, i) => cultureEls.get(c.id)!.text.setAttribute('transform', `translate(${cpts[i].x.toFixed(1)},${cpts[i].y.toFixed(1)})`));
    const spts = spreadLabels(skeins.map((s) => { const b = boundsOfNotes(s.noteIds)!; return { x: s.x, y: b.y0 - px(14) }; }), px(narrow ? 120 : 150), px(20));
    skeins.forEach((s, i) => { const t = skeinEls.get(s.id)!.text; t.setAttribute('x', spts[i].x.toFixed(1)); t.setAttribute('y', spts[i].y.toFixed(1)); });
  }
  if (reduced) { for (let i = 0; i < 300; i++) sim.tick(); render(); }
  else sim.on('tick', render);
  sim.on('end', () => { if (autoFit) fitAll(false); });

  // ---- where you are: derived from the camera, not from a mode ----
  function nearestRegion(list: Region[]): Region | null {
    const cx = (VW / 2 - camX) / camK, cy = (VH / 2 - camY) / camK;
    let best: Region | null = null, bd = Infinity;
    for (const r of list) { const d = Math.hypot(r.x - cx, r.y - cy); if (d < bd) { bd = d; best = r; } }
    return best;
  }
  let lastCrumbKey = '';
  function updateCrumbs() {
    const z = camK / k0;
    const parts: { label: string; go?: () => void }[] = [{ label: 'Cosmos', go: flyHome }];
    if (z >= 1.45) {
      const c = nearestRegion(cultures);
      if (c) {
        parts.push({ label: c.label, go: () => flyToCulture(c.id) });
        if (z >= 3.2) {
          const s = nearestRegion(skeins.filter((x) => x.cultureId === c.id)) ?? nearestRegion(skeins);
          if (s) parts.push({ label: `“${s.anchor}”`, go: () => flyToSkein(s.id) });
        }
      }
    }
    const key = parts.map((p) => p.label).join('|');
    if (key === lastCrumbKey) return;
    lastCrumbKey = key;
    crumbBar.replaceChildren();
    parts.forEach((p, i) => {
      if (i > 0) { const sep = document.createElement('span'); sep.className = 'crumb-sep'; sep.textContent = '›'; crumbBar.appendChild(sep); }
      if (i === parts.length - 1) { const span = document.createElement('span'); span.className = 'crumb-current'; span.textContent = p.label; crumbBar.appendChild(span); }
      else { const btn = document.createElement('button'); btn.type = 'button'; btn.textContent = p.label; btn.addEventListener('click', p.go!); crumbBar.appendChild(btn); }
    });
  }

  // ---- pan, wheel zoom, pinch zoom ----
  const pointers = new Map<number, { x: number; y: number }>();
  let pinchDist = 0, dragMoved = false;
  svg.addEventListener('pointerdown', (e) => {
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    dragMoved = false;
    if (pointers.size === 2) { const [a, b] = Array.from(pointers.values()); pinchDist = Math.hypot(a.x - b.x, a.y - b.y); }
    svg.classList.add('dragging');
    (e.target as Element).setPointerCapture?.(e.pointerId);
  });
  svg.addEventListener('pointermove', (e) => {
    if (!pointers.has(e.pointerId)) return;
    const prev = pointers.get(e.pointerId)!;
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pointers.size === 2) {
      const [a, b] = Array.from(pointers.values());
      const d = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinchDist > 0) zoomAt((a.x + b.x) / 2, (a.y + b.y) / 2, d / pinchDist);
      pinchDist = d;
      return;
    }
    const upp = unitsPerPx();
    const dx = e.clientX - prev.x, dy = e.clientY - prev.y;
    if (Math.abs(dx) + Math.abs(dy) > 2) dragMoved = true;
    camX += dx * upp; camY += dy * upp;
    autoFit = false;
    cancelAnimationFrame(animFrame);
    applyCamera();
  });
  const endPointer = (e: PointerEvent) => { pointers.delete(e.pointerId); if (pointers.size < 2) pinchDist = 0; if (!pointers.size) svg.classList.remove('dragging'); };
  svg.addEventListener('pointerup', endPointer);
  svg.addEventListener('pointercancel', endPointer);
  svg.addEventListener('pointerleave', endPointer);

  function zoomAt(clientX: number, clientY: number, factor: number) {
    const rect = svg.getBoundingClientRect();
    const mx = (clientX - rect.left) * (VW / rect.width);
    const my = (clientY - rect.top) * (VH / rect.height);
    const nk = Math.max(k0 * 0.55, Math.min(k0 * 9, camK * factor));
    const f = nk / camK;
    camX = mx * (1 - f) + camX * f;
    camY = my * (1 - f) + camY * f;
    camK = nk;
    autoFit = false;
    cancelAnimationFrame(animFrame);
    applyCamera();
  }
  svg.addEventListener('wheel', (e) => {
    e.preventDefault();
    const dy = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaMode === 2 ? e.deltaY * 400 : e.deltaY;
    zoomAt(e.clientX, e.clientY, Math.max(0.75, Math.min(1.33, Math.exp(-dy * 0.0018))));
  }, { passive: false });
  const centerZoom = (f: number) => { const r = svg.getBoundingClientRect(); zoomAt(r.left + r.width / 2, r.top + r.height / 2, f); };
  document.getElementById('zoom-in')!.addEventListener('click', () => centerZoom(1.3));
  document.getElementById('zoom-out')!.addEventListener('click', () => centerZoom(1 / 1.3));
  document.getElementById('zoom-reset')!.addEventListener('click', flyHome);

  // ---- hover: highlight + card. Never moves the camera. ----
  function clearHot() {
    for (const el of noteEls.values()) el.g.classList.remove('hot', 'dim');
    for (const e of edgeEls) e.vis.classList.remove('hot', 'dim');
    for (const el of [...cultureEls.values(), ...skeinEls.values()]) el.path.classList.remove('hot');
    nodeCard.hidden = true;
  }
  const showCard = (html: string) => { nodeCard.hidden = false; nodeCard.innerHTML = html; };

  for (const c of cultures) {
    const { path } = cultureEls.get(c.id)!;
    path.addEventListener('pointerenter', () => {
      path.classList.add('hot');
      showCard(`<div class="nc-part">A Culture · ${c.skeinIds!.length} Skein${c.skeinIds!.length === 1 ? '' : 's'} · ${c.noteIds.length} notes</div><div class="nc-title">${c.label}</div><div class="nc-sub">${visitedIn(c.noteIds)}/${c.noteIds.length} visited · anchored by “${c.anchor}”</div>`);
    });
    path.addEventListener('pointerleave', clearHot);
    path.addEventListener('click', () => { if (!dragMoved) flyToCulture(c.id); });
  }
  for (const s of skeins) {
    const { path } = skeinEls.get(s.id)!;
    path.addEventListener('pointerenter', () => {
      path.classList.add('hot');
      showCard(`<div class="nc-part">A Skein · ${s.noteIds.length} note${s.noteIds.length === 1 ? '' : 's'}</div><div class="nc-title">${s.label}</div><div class="nc-sub">${visitedIn(s.noteIds)}/${s.noteIds.length} visited · anchored by “${s.anchor}”</div>`);
    });
    path.addEventListener('pointerleave', clearHot);
    path.addEventListener('click', () => { if (!dragMoved) flyToSkein(s.id); });
  }
  for (const n of notes) {
    const { g } = noteEls.get(n.id)!;
    g.addEventListener('pointerenter', () => {
      g.classList.add('hot');
      const linked = new Set([n.id]);
      for (const e of edgeEls) {
        const hot = e.a === n.id || e.b === n.id;
        e.vis.classList.toggle('hot', hot); e.vis.classList.toggle('dim', !hot);
        if (hot) { linked.add(e.a); linked.add(e.b); }
      }
      if (camK / k0 >= 2.0) for (const [nid, el] of noteEls) el.g.classList.toggle('dim', !linked.has(nid));
      const partLabel = n.group === 'thirds' ? 'A Standing Third' : (cultureById.get(n.cultureId)?.label ?? n.group);
      showCard(`<div class="nc-part">${partLabel} · ${n.degree} connection${n.degree === 1 ? '' : 's'}</div><div class="nc-title">${n.title}</div>`);
    });
    g.addEventListener('pointerleave', clearHot);
    g.addEventListener('click', (e) => {
      if (dragMoved) { e.preventDefault(); return; }
      // too far to read? fly there instead of opening it
      if (camK / k0 < 3.8) { e.preventDefault(); flyToSkein(n.skeinId); }
    });
  }
  for (const e of edgeEls) {
    e.hit.addEventListener('pointerenter', () => {
      e.vis.classList.add('hot');
      const a = noteById.get(e.a)!, b = noteById.get(e.b)!;
      noteEls.get(e.a)!.g.classList.add('hot'); noteEls.get(e.b)!.g.classList.add('hot');
      showCard(`<div class="nc-part">A Dyad</div><div class="nc-title">${a.title} ↔ ${b.title}</div>`);
    });
    e.hit.addEventListener('pointerleave', clearHot);
  }

  applyCamera();
</script>
