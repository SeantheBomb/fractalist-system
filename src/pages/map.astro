---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { PARTS } from '../../scripts/manifest.mjs';
import graphJson from '../data/concepts.json';

const nodesC = await getCollection('nodes');

// ---- concepts: the map's real bodies ----
// Every concept already knows its scale (where the book gives one), its lineage (what it
// grows out of or fuses), and which concepts it shares pages with, weighted. None of that
// is computed here — it comes straight from src/data/concepts.json.
const RING_ORDER = ['core', 'self', 'dyad', 'skein', 'culture', 'cosmos'] as const;
type Ring = (typeof RING_ORDER)[number];
const ringOf = (scale: string | null): Ring => (scale && scale !== 'every' ? (scale as Ring) : 'core');

interface ConceptItem {
  id: string; kind: 'concept'; conceptKind: string; href: string; title: string; blurb: string;
  ring: Ring; scale: string | null; mass: number; appearsOn: string[];
}
const concepts: ConceptItem[] = graphJson.concepts.map((c) => ({
  id: c.slug, kind: 'concept', conceptKind: c.kind, href: c.href, title: c.name, blurb: c.blurb,
  ring: ringOf(c.scale), scale: c.scale,
  mass: c.appearsOn.length + c.growsInto.length + c.stemsFrom.length + c.fusionOf.length,
  appearsOn: c.appearsOn,
}));
const conceptIds = new Set(concepts.map((c) => c.id));

// concept ↔ concept, weighted by how many pages they share — the map's gravity
const sharesEdges: { a: string; b: string; weight: number }[] = [];
{
  const seen = new Set<string>();
  for (const c of graphJson.concepts) for (const r of c.related) {
    if (!conceptIds.has(r.slug)) continue;
    const key = [c.slug, r.slug].sort().join('|');
    if (seen.has(key)) continue;
    seen.add(key);
    sharesEdges.push({ a: c.slug, b: r.slug, weight: r.weight });
  }
}

// concept → concept, directional — what it grows out of or fuses. Fewer, and structural
// rather than incidental, so they're drawn as a distinct kind of line.
const lineageEdges: { from: string; to: string; kind: 'stem' | 'fusion' }[] = [];
for (const c of graphJson.concepts) {
  for (const p of c.stemsFrom) if (conceptIds.has(p)) lineageEdges.push({ from: p, to: c.slug, kind: 'stem' });
  for (const p of c.fusionOf) if (conceptIds.has(p)) lineageEdges.push({ from: p, to: c.slug, kind: 'fusion' });
}

// ---- pages: satellites, not simulated bodies. A page's place is the pages it keeps
// company with — the centroid of the concepts it holds — recomputed every physics tick. ----
interface PageItem {
  id: string; kind: 'page'; href: string; title: string; summary: string; part: string; color: string; concepts: string[];
}
const pages: PageItem[] = nodesC.map((n) => ({
  id: n.id, kind: 'page', href: `/node/${n.id}/`, title: n.data.title, summary: n.data.summary,
  part: n.data.part, color: PARTS[n.data.part]?.color ?? 'var(--muted)',
  concepts: (graphJson.pageConcepts as Record<string, string[]>)[n.id] ?? [],
}));

const RING_META: Record<Ring, { label: string; color: string }> = {
  core: { label: 'Foundational', color: 'var(--k-core)' },
  self: { label: 'Self', color: 'var(--k-self)' },
  dyad: { label: 'Dyad', color: 'var(--k-dyad)' },
  skein: { label: 'Skein', color: 'var(--k-skein)' },
  culture: { label: 'Culture', color: 'var(--k-culture)' },
  cosmos: { label: 'Cosmos', color: 'var(--k-cosmos)' },
};

const graphData = { concepts, pages, sharesEdges, lineageEdges, rings: RING_ORDER.map((r) => ({ id: r, ...RING_META[r] })) };
---
<Base title="The Map" description="Every concept in Fractalism and how they actually relate — what each grows out of, what pages hold it, and where its scale sits it." wide>
  <h1>The Map</h1>
  <p style="max-width: 44rem; color: var(--muted);">
    This is the shape of the ideas, not the pages. Each star is one concept — a Loop Tongue word,
    an idea from the Loom, or a Standing Third — sized by how widely it's used and how much grows
    out of it. Foundational concepts sit at the center; the rest sit in the scale the book gives
    them, Self to Cosmos, outward. The dim points drifting near a cluster of concepts are the
    chapters that hold them. Bright spokes are lineage — what a concept grows out of, or fuses.
  </p>

  <div class="crumb-bar" id="crumb-bar" role="navigation" aria-label="Where you are"></div>

  <div class="map-frame">
    <svg id="graph" viewBox="0 0 1100 860" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id="nebula-soft" x="-60%" y="-60%" width="220%" height="220%">
          <feGaussianBlur stdDeviation="30" />
        </filter>
        <marker id="lineage-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
          <path d="M0,0 L8,4 L0,8 Z" />
        </marker>
      </defs>
      <g id="camera">
        <g id="dust"></g>
        <g id="ringHulls"></g>
        <g id="pageLayer"></g>
        <g id="shareLayer"></g>
        <g id="lineageLayer"></g>
        <g id="conceptLayer"></g>
        <g id="ringLabels"></g>
      </g>
    </svg>
    <div class="vignette" aria-hidden="true"></div>
    <div class="map-controls">
      <button id="zoom-in" type="button" aria-label="Zoom in">+</button>
      <button id="zoom-out" type="button" aria-label="Zoom out">−</button>
      <button id="zoom-reset" type="button" aria-label="Back to the whole map">⟲</button>
    </div>
    <div id="node-card" class="node-card" hidden></div>
  </div>

  <p class="map-legend">
    <span id="thread-count"></span>
    Drag to pan, scroll or pinch to zoom, click anything to fly to it. When a star or a page is
    close enough to read, clicking it opens it.
    Prefer a list? <a href="/concepts/">Every concept</a> in reading order, or
    <a href="/book/">The Book</a> in printed order.
  </p>

  <script type="application/json" id="graph-data" set:html={JSON.stringify(graphData).replace(/</g, '\\u003c')} />
</Base>

<style is:global>
  .crumb-bar {
    display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;
    margin-top: 1.5rem; font-family: var(--sans); font-size: 0.85rem; min-height: 1.6rem;
  }
  .crumb-bar button {
    font: inherit; background: none; border: none; color: var(--muted); cursor: pointer;
    padding: 0.15rem 0.3rem; border-radius: 6px;
  }
  .crumb-bar button:hover { color: var(--accent); background: var(--bg2); }
  .crumb-bar .crumb-current { color: var(--ink); font-weight: 600; padding: 0.15rem 0.3rem; }
  .crumb-bar .crumb-sep { color: var(--line); }

  .map-frame {
    position: relative; border: 1px solid var(--line); border-radius: 14px;
    background: var(--bg2); margin-top: 0.75rem; overflow: hidden;
  }
  #graph { display: block; width: 100%; height: min(78vh, 720px); touch-action: none; cursor: grab; }
  #graph.dragging { cursor: grabbing; }
  .vignette {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 52%, color-mix(in srgb, var(--ink) 10%, transparent) 100%);
  }

  #dust circle { fill: var(--muted); }
  #dust circle.tw { animation: dust-twinkle 5s ease-in-out infinite; }
  @keyframes dust-twinkle { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }

  #ringHulls circle { fill: none; stroke-opacity: 0.4; stroke-dasharray: 1 9; stroke-linecap: round; transition: stroke-opacity 0.2s ease; }
  #ringHulls circle.hot { stroke-opacity: 0.75 !important; }

  /* shared-page edges: the map's gravity, faint until close */
  #shareLayer .share { stroke: var(--muted); vector-effect: non-scaling-stroke; transition: opacity 0.12s ease, stroke 0.12s ease; }
  #shareLayer .share-hit { stroke: transparent; stroke-width: 14; vector-effect: non-scaling-stroke; cursor: pointer; }
  #shareLayer .share.hot { stroke: var(--accent); opacity: 1 !important; }
  #shareLayer .share.dim { opacity: 0.04 !important; }

  /* lineage: fewer, structural, visible further out */
  #lineageLayer .lineage { fill: none; vector-effect: non-scaling-stroke; marker-end: url(#lineage-arrow); transition: opacity 0.12s ease; }
  #lineageLayer .lineage.stem { stroke: var(--accent); stroke-opacity: 0.55; }
  #lineageLayer .lineage.fusion { stroke: var(--gold); stroke-opacity: 0.6; stroke-dasharray: 1 4; }
  #lineageLayer .lineage.hot { stroke-opacity: 1 !important; stroke-width: 2.2; }
  #lineageLayer .lineage.dim { opacity: 0.08; }
  #lineageLayer path { fill: var(--accent); }

  /* concepts: the stars */
  .cnode { cursor: pointer; }
  .cnode circle { stroke: var(--bg2); transition: opacity 0.15s ease; }
  .cnode.visited circle { filter: drop-shadow(0 0 3px currentColor); }
  .cnode text {
    font-family: var(--sans); fill: var(--ink); text-anchor: middle; pointer-events: none;
    paint-order: stroke; stroke: var(--bg2); stroke-linejoin: round;
    opacity: var(--lbl, 0); transition: opacity 0.15s ease;
  }
  .cnode.hot circle { opacity: 1 !important; filter: drop-shadow(0 0 5px currentColor); }
  .cnode.hot text { opacity: 1; font-weight: 600; }
  .cnode.dim circle { opacity: 0.1 !important; }
  .cnode.dim text { opacity: 0 !important; }
  .cnode.word circle { stroke-width: 2; }

  /* pages: dim satellites */
  .pnode { cursor: pointer; }
  .pnode circle { fill: var(--muted); transition: opacity 0.15s ease; }
  .pnode text {
    font-family: var(--sans); fill: var(--ink); text-anchor: middle; pointer-events: none;
    paint-order: stroke; stroke: var(--bg2); stroke-linejoin: round;
    opacity: var(--plbl, 0); transition: opacity 0.15s ease;
  }
  .pnode.hot circle { fill: var(--accent); opacity: 1 !important; }
  .pnode.hot text { opacity: 1; font-weight: 600; }
  .pnode.dim circle { opacity: 0.08 !important; }
  .pnode.dim text { opacity: 0 !important; }

  #ringLabels text {
    font-family: var(--sans); text-anchor: middle; pointer-events: none;
    paint-order: stroke; stroke: var(--bg2); stroke-linejoin: round; fill: var(--ink);
    font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
  }

  .map-controls { position: absolute; right: 0.75rem; bottom: 0.75rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .map-controls button {
    width: 30px; height: 30px; border-radius: 8px; border: 1px solid var(--line);
    background: var(--bg); color: var(--ink); font-size: 1rem; line-height: 1; cursor: pointer;
  }
  .map-controls button:hover { border-color: var(--accent); }

  .node-card {
    position: absolute; left: 0.85rem; top: 0.85rem; max-width: 17rem;
    background: var(--bg); border: 1px solid var(--line); border-radius: 10px;
    padding: 0.6rem 0.8rem; font-family: var(--sans); font-size: 0.78rem; pointer-events: none;
  }
  .node-card .nc-part { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .node-card .nc-title { font-family: var(--serif); font-size: 1rem; margin-top: 0.15rem; color: var(--ink); }
  .node-card .nc-sub { margin-top: 0.3rem; color: var(--muted); }

  .map-legend { font-family: var(--sans); font-size: 0.85rem; color: var(--muted); margin-top: 1rem; }

  @media (prefers-reduced-motion: reduce) { #dust circle.tw { animation: none; } }
</style>

<script>
  import { forceSimulation, forceManyBody, forceLink, forceCollide, forceRadial, forceX, forceY } from 'd3-force';

  interface Concept { id: string; kind: 'concept'; conceptKind: string; href: string; title: string; blurb: string; ring: string; scale: string | null; mass: number; appearsOn: string[]; r: number; x?: number; y?: number; }
  interface PageRaw { id: string; kind: 'page'; href: string; title: string; summary: string; part: string; color: string; concepts: string[]; }
  interface PagePos extends PageRaw { x: number; y: number; r: number; }
  interface RingMeta { id: string; label: string; color: string }

  const data = JSON.parse(document.getElementById('graph-data')!.textContent || '{}') as {
    concepts: Omit<Concept, 'r'>[]; pages: PageRaw[];
    sharesEdges: { a: string; b: string; weight: number }[];
    lineageEdges: { from: string; to: string; kind: 'stem' | 'fusion' }[];
    rings: RingMeta[];
  };

  const RING_RADIUS: Record<string, number> = { core: 0, self: 230, dyad: 380, skein: 530, culture: 680, cosmos: 830 };
  const ringMeta = new Map(data.rings.map((r) => [r.id, r]));

  const concepts: Concept[] = data.concepts.map((c) => ({ ...c, r: 3.2 + Math.min(11, Math.sqrt(c.mass) * 2.6) }));
  const conceptById = new Map(concepts.map((c) => [c.id, c]));
  // a deterministic seed per page so identical concept-sets don't stack exactly
  const seed = (s: string) => { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return (h >>> 0) / 4294967296; };
  const pages: PagePos[] = data.pages.map((p) => ({ ...p, x: 0, y: 0, r: 2.4 }));
  const pageById = new Map(pages.map((p) => [p.id, p]));

  const svg = document.getElementById('graph') as unknown as SVGSVGElement;
  const camera = document.getElementById('camera')!;
  const dustG = document.getElementById('dust')!;
  const ringHullG = document.getElementById('ringHulls')!;
  const pageG = document.getElementById('pageLayer')!;
  const shareG = document.getElementById('shareLayer')!;
  const lineageG = document.getElementById('lineageLayer')!;
  const conceptG = document.getElementById('conceptLayer')!;
  const ringLabelG = document.getElementById('ringLabels')!;
  const nodeCard = document.getElementById('node-card') as HTMLDivElement;
  const crumbBar = document.getElementById('crumb-bar')!;
  const NS = 'http://www.w3.org/2000/svg';
  let VW = 1100, VH = 860;
  function syncViewBox() {
    const r = svg.getBoundingClientRect();
    if (r.width > 0 && r.height > 0) VH = Math.round(VW * (r.height / r.width));
    svg.setAttribute('viewBox', `0 0 ${VW} ${VH}`);
  }
  syncViewBox();
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const band = (v: number, a: number, b: number) => { if (v <= a) return 0; if (v >= b) return 1; const t = (v - a) / (b - a); return t * t * (3 - 2 * t); };

  // ---- physics ----
  // Concepts settle by two forces at once: shared pages pull related ideas together, and a
  // radial force keeps each concept in the ring its scale actually belongs to — the same
  // Self→Cosmos nesting the Weaving already uses, now literal rather than decorative.
  const sim = forceSimulation(concepts as any)
    .force('charge', forceManyBody().strength((d: any) => -40 - d.mass * 5))
    .force('share', forceLink(data.sharesEdges.map((e) => ({ source: e.a, target: e.b, weight: e.weight })) as any)
      .id((d: any) => d.id).distance((d: any) => 20 + (d.source.r ?? 5) + (d.target.r ?? 5))
      .strength((d: any) => Math.min(0.22, 0.04 + d.weight * 0.03)))
    .force('lineage', forceLink(data.lineageEdges.map((e) => ({ source: e.from, target: e.to })) as any)
      .id((d: any) => d.id).distance(40).strength(0.08))
    .force('radial', forceRadial((d: any) => RING_RADIUS[d.ring] ?? 0, 0, 0).strength((d: any) => (d.ring === 'core' ? 0.55 : 0.6)))
    .force('collide', forceCollide().radius((d: any) => d.r + 5).strength(0.85).iterations(2))
    .alphaDecay(reduced ? 1 : 0.02);

  // ---- background dust ----
  (function seedDust() {
    let s = 20260917;
    const rnd = () => { s = (s * 1664525 + 1013904223) >>> 0; return s / 4294967296; };
    for (let i = 0; i < 520; i++) {
      const ang = rnd() * Math.PI * 2;
      const rad = 120 + Math.pow(rnd(), 0.6) * 1100;
      const c = document.createElementNS(NS, 'circle');
      c.setAttribute('cx', (Math.cos(ang) * rad).toFixed(1));
      c.setAttribute('cy', (Math.sin(ang) * rad * 0.85).toFixed(1));
      c.setAttribute('r', (0.5 + rnd() * 0.9).toFixed(2));
      c.setAttribute('opacity', (0.12 + rnd() * 0.22).toFixed(2));
      if (rnd() < 0.22) { c.setAttribute('class', 'tw'); c.style.animationDelay = `${(rnd() * 5).toFixed(2)}s`; }
      dustG.appendChild(c);
    }
  })();

  // ---- ring nebulae: concentric and fixed, largest drawn first so smaller rings paint
  // on top of them and stay visible ----
  const ringEls = new Map([...data.rings].reverse().map((r) => {
    const circle = document.createElementNS(NS, 'circle');
    circle.setAttribute('style', `stroke:${r.color}`);
    circle.dataset.id = r.id;
    ringHullG.appendChild(circle);
    const text = document.createElementNS(NS, 'text');
    text.textContent = r.label;
    ringLabelG.appendChild(text);
    return [r.id, { circle, text }];
  }));

  // ---- DOM: concepts ----
  const conceptEls = new Map<string, { g: SVGAElement; c: SVGCircleElement; t: SVGTextElement }>();
  for (const c of concepts) {
    const g = document.createElementNS(NS, 'a') as unknown as SVGAElement;
    g.setAttribute('href', c.href);
    g.setAttribute('class', `cnode${c.conceptKind === 'word' ? ' word' : ''}`);
    g.dataset.id = c.id;
    const circ = document.createElementNS(NS, 'circle');
    circ.setAttribute('style', `fill:${ringMeta.get(c.ring)?.color ?? 'var(--muted)'}`);
    const t = document.createElementNS(NS, 'text');
    t.textContent = c.title;
    g.appendChild(circ); g.appendChild(t);
    conceptG.appendChild(g);
    conceptEls.set(c.id, { g, c: circ, t });
  }

  // ---- DOM: page satellites ----
  const pageEls = new Map<string, { g: SVGAElement; c: SVGCircleElement; t: SVGTextElement }>();
  for (const p of pages) {
    const g = document.createElementNS(NS, 'a') as unknown as SVGAElement;
    g.setAttribute('href', p.href); g.setAttribute('class', 'pnode'); g.dataset.id = p.id;
    const circ = document.createElementNS(NS, 'circle');
    const t = document.createElementNS(NS, 'text');
    t.textContent = p.title;
    g.appendChild(circ); g.appendChild(t);
    pageG.appendChild(g);
    pageEls.set(p.id, { g, c: circ, t });
  }

  // ---- DOM: edges ----
  const shareEls = data.sharesEdges.map((e) => {
    const vis = document.createElementNS(NS, 'line'); vis.setAttribute('class', 'share');
    const hit = document.createElementNS(NS, 'line'); hit.setAttribute('class', 'share-hit');
    shareG.appendChild(vis); shareG.appendChild(hit);
    return { vis, hit, a: e.a, b: e.b, weight: e.weight };
  });
  const lineageEls = data.lineageEdges.map((e) => {
    const path = document.createElementNS(NS, 'path'); path.setAttribute('class', `lineage ${e.kind}`);
    lineageG.appendChild(path);
    return { path, from: e.from, to: e.to, kind: e.kind };
  });

  // ---- visited thread ----
  let thread: string[] = [];
  try { thread = JSON.parse(localStorage.getItem('fractalism-thread') || '[]'); } catch {}
  const visited = new Set(thread.map((t) => t.split(':')[1]));
  let visitedCount = 0;
  for (const [id, { g }] of conceptEls) if (visited.has(id)) { g.classList.add('visited'); visitedCount++; }
  const tc = document.getElementById('thread-count');
  if (tc && visitedCount > 0) tc.textContent = `Your thread so far: ${visitedCount} of ${concepts.length} concepts lit. `;

  // ---- geometry helpers ----
  function boundsOfConcepts(ids: string[]) {
    const pts = ids.map((id) => conceptById.get(id)!).filter(Boolean);
    if (!pts.length) return null;
    let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
    for (const p of pts) {
      x0 = Math.min(x0, (p.x ?? 0) - p.r); x1 = Math.max(x1, (p.x ?? 0) + p.r);
      y0 = Math.min(y0, (p.y ?? 0) - p.r); y1 = Math.max(y1, (p.y ?? 0) + p.r);
    }
    return { x0, y0, x1, y1 };
  }
  function boundsOfRing(ring: string) {
    return boundsOfConcepts(concepts.filter((c) => c.ring === ring).map((c) => c.id));
  }

  // ---- camera ----
  let camX = VW / 2, camY = VH / 2, camK = 1, k0 = 1;
  let autoFit = true;
  const unitsPerPx = () => VW / svg.getBoundingClientRect().width;
  const frameWidth = () => svg.getBoundingClientRect().width;
  const padFor = (p: number) => Math.min(p, frameWidth() * 0.14);

  function applyCamera() {
    camera.setAttribute('transform', `translate(${camX.toFixed(2)},${camY.toFixed(2)}) scale(${camK.toFixed(4)})`);
    updateLOD();
    updateCrumbs();
  }
  function fitK(b: { x0: number; y0: number; x1: number; y1: number }, padPx: number) {
    const upp = unitsPerPx();
    const w = Math.max(40, b.x1 - b.x0) + padPx * upp * 2;
    const h = Math.max(40, b.y1 - b.y0) + padPx * upp * 2;
    return Math.min(VW / w, VH / h);
  }
  let animFrame = 0;
  function fitTo(b: { x0: number; y0: number; x1: number; y1: number } | null, animate = !reduced, padPx = 60, kMax = Infinity, kMin = 0) {
    if (!b) return;
    const k = Math.max(kMin, Math.min(kMax, fitK(b, padPx)));
    const cx = (b.x0 + b.x1) / 2, cy = (b.y0 + b.y1) / 2;
    const tx = VW / 2 - cx * k, ty = VH / 2 - cy * k;
    cancelAnimationFrame(animFrame);
    if (!animate) { camX = tx; camY = ty; camK = k; applyCamera(); return; }
    const sx = camX, sy = camY, sk = camK, dur = 780, start = performance.now();
    function step(now: number) {
      const t = Math.min(1, (now - start) / dur);
      const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      camX = sx + (tx - sx) * e; camY = sy + (ty - sy) * e;
      camK = Math.exp(Math.log(sk) + (Math.log(k) - Math.log(sk)) * e);
      applyCamera();
      if (t < 1) animFrame = requestAnimationFrame(step);
    }
    animFrame = requestAnimationFrame(step);
  }
  function fitAll(animate: boolean) {
    const b = boundsOfConcepts(concepts.map((c) => c.id));
    if (!b) return;
    k0 = fitK(b, padFor(80));
    fitTo(b, animate, padFor(80));
  }
  const flyToRing = (ring: string) => { autoFit = false; fitTo(boundsOfRing(ring), true, padFor(80), k0 * 5, k0 * 1.4); };
  new ResizeObserver(() => { syncViewBox(); if (autoFit) fitAll(false); else applyCamera(); }).observe(svg);
  const flyHome = () => { autoFit = false; fitAll(true); };

  // ---- LOD ----
  function updateLOD() {
    const z = camK / k0;
    const upp = unitsPerPx();
    const px = (n: number) => (n * upp) / camK;
    const narrow = frameWidth() < 600;
    const close = band(z, 1.0, 3.2);

    for (const c of concepts) {
      const el = conceptEls.get(c.id)!;
      el.c.setAttribute('r', px(c.r * (0.5 + 0.8 * close)).toFixed(2));
      el.t.setAttribute('y', px(c.r * (0.5 + 0.8 * close) + 11).toFixed(2));
    }
    conceptG.style.opacity = String(0.5 + 0.5 * close);
    conceptG.style.setProperty('--lbl', String(band(z, 1.6, 3.0)));
    conceptG.style.fontSize = `${px(narrow ? 9 : 10)}px`;
    conceptG.style.strokeWidth = `${px(2.4)}px`;

    const pageVis = band(z, 2.6, 4.2);
    for (const p of pages) { const el = pageEls.get(p.id)!; el.c.setAttribute('r', px(2.4).toFixed(2)); el.t.setAttribute('y', px(11).toFixed(2)); }
    pageG.style.opacity = String(pageVis);
    pageG.style.pointerEvents = z >= 2.6 ? '' : 'none';
    pageG.style.setProperty('--plbl', String(band(z, 4.0, 5.6)));
    pageG.style.fontSize = `${px(narrow ? 8 : 9)}px`;
    pageG.style.strokeWidth = `${px(2)}px`;

    shareG.style.opacity = String(band(z, 1.9, 3.4));
    shareG.style.pointerEvents = z >= 2.2 ? '' : 'none';
    lineageG.style.opacity = String(1 - 0.55 * band(z, 1.0, 2.4));
    lineageG.style.strokeWidth = `${px(1.4)}px`;

    ringLabelG.style.opacity = String(1 - band(z, 1.3, 2.4));
    ringLabelG.style.fontSize = `${px(narrow ? 12 : 15)}px`;
    ringLabelG.style.strokeWidth = `${px(4)}px`;
    ringHullG.style.pointerEvents = z < 1.8 ? '' : 'none';
    for (const { circle } of ringEls.values()) circle.setAttribute('stroke-width', px(3).toFixed(1));

    dustG.style.opacity = String(1 - band(z, 2.0, 3.4));
  }

  // ---- render: geometry only, runs on physics ticks ----
  function render() {
    for (const c of concepts) conceptEls.get(c.id)!.g.setAttribute('transform', `translate(${(c.x ?? 0).toFixed(1)},${(c.y ?? 0).toFixed(1)})`);
    for (const e of shareEls) {
      const a = conceptById.get(e.a), b = conceptById.get(e.b);
      if (!a || !b) continue;
      for (const line of [e.vis, e.hit]) {
        line.setAttribute('x1', (a.x ?? 0).toFixed(1)); line.setAttribute('y1', (a.y ?? 0).toFixed(1));
        line.setAttribute('x2', (b.x ?? 0).toFixed(1)); line.setAttribute('y2', (b.y ?? 0).toFixed(1));
      }
      e.vis.setAttribute('stroke-width', String(Math.min(2.5, 0.5 + e.weight * 0.7)));
      e.vis.setAttribute('opacity', String(Math.min(0.7, 0.15 + e.weight * 0.2)));
    }
    for (const e of lineageEls) {
      const a = conceptById.get(e.from), b = conceptById.get(e.to);
      if (!a || !b) continue;
      e.path.setAttribute('d', `M${(a.x ?? 0).toFixed(1)},${(a.y ?? 0).toFixed(1)} L${(b.x ?? 0).toFixed(1)},${(b.y ?? 0).toFixed(1)}`);
    }
    // pages drift to the centroid of the concepts they hold, with a small stable offset
    // so pages sharing an identical concept-set don't sit exactly on top of each other
    for (const p of pages) {
      const holds = p.concepts.map((id) => conceptById.get(id)).filter(Boolean) as Concept[];
      if (holds.length) {
        let sx = 0, sy = 0; for (const c of holds) { sx += c.x ?? 0; sy += c.y ?? 0; }
        const jitter = seed(p.id) * Math.PI * 2, jr = 10 + seed(p.id + '.') * 22;
        p.x = sx / holds.length + Math.cos(jitter) * jr;
        p.y = sy / holds.length + Math.sin(jitter) * jr;
      }
      pageEls.get(p.id)!.g.setAttribute('transform', `translate(${p.x.toFixed(1)},${p.y.toFixed(1)})`);
    }
    // Rings are literal and fixed at the center — the same nesting the Weaving already draws
    // by hand — so the scale structure reads even while concepts settle inside it.
    for (const [ring, radius] of Object.entries(RING_RADIUS)) {
      const el = ringEls.get(ring)!;
      const rad = ring === 'core' ? Math.max(90, RING_RADIUS.self * 0.55) : radius + 90;
      el.circle.setAttribute('cx', '0'); el.circle.setAttribute('cy', '0'); el.circle.setAttribute('r', rad.toFixed(1));
      el.text.setAttribute('x', '0'); el.text.setAttribute('y', (-rad + 22).toFixed(1));
    }
    if (autoFit) fitAll(false);
  }
  if (reduced) { for (let i = 0; i < 300; i++) sim.tick(); render(); }
  else sim.on('tick', render);
  sim.on('end', () => { if (autoFit) fitAll(false); });

  // ---- where you are ----
  function nearestRing(): string {
    const cx = (VW / 2 - camX) / camK, cy = (VH / 2 - camY) / camK;
    let best = 'core', bd = Infinity;
    for (const r of data.rings) {
      const b = boundsOfRing(r.id); if (!b) continue;
      const rcx = (b.x0 + b.x1) / 2, rcy = (b.y0 + b.y1) / 2;
      const d = Math.hypot(rcx - cx, rcy - cy);
      if (d < bd) { bd = d; best = r.id; }
    }
    return best;
  }
  let lastCrumbKey = '';
  function updateCrumbs() {
    const z = camK / k0;
    const parts: { label: string; go?: () => void }[] = [{ label: 'The Map', go: flyHome }];
    if (z >= 1.35) {
      const ring = nearestRing();
      const meta = ringMeta.get(ring)!;
      parts.push({ label: meta.label, go: () => flyToRing(ring) });
    }
    const key = parts.map((p) => p.label).join('|');
    if (key === lastCrumbKey) return;
    lastCrumbKey = key;
    crumbBar.replaceChildren();
    parts.forEach((p, i) => {
      if (i > 0) { const sep = document.createElement('span'); sep.className = 'crumb-sep'; sep.textContent = '›'; crumbBar.appendChild(sep); }
      if (i === parts.length - 1) { const span = document.createElement('span'); span.className = 'crumb-current'; span.textContent = p.label; crumbBar.appendChild(span); }
      else { const btn = document.createElement('button'); btn.type = 'button'; btn.textContent = p.label; btn.addEventListener('click', p.go!); crumbBar.appendChild(btn); }
    });
  }

  // ---- pan, wheel zoom, pinch zoom ----
  const pointers = new Map<number, { x: number; y: number }>();
  let pinchDist = 0, dragMoved = false;
  svg.addEventListener('pointerdown', (e) => {
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    dragMoved = false;
    if (pointers.size === 2) { const [a, b] = Array.from(pointers.values()); pinchDist = Math.hypot(a.x - b.x, a.y - b.y); }
    svg.classList.add('dragging');
    (e.target as Element).setPointerCapture?.(e.pointerId);
  });
  svg.addEventListener('pointermove', (e) => {
    if (!pointers.has(e.pointerId)) return;
    const prev = pointers.get(e.pointerId)!;
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pointers.size === 2) {
      const [a, b] = Array.from(pointers.values());
      const d = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinchDist > 0) zoomAt((a.x + b.x) / 2, (a.y + b.y) / 2, d / pinchDist);
      pinchDist = d;
      return;
    }
    const upp = unitsPerPx();
    const dx = e.clientX - prev.x, dy = e.clientY - prev.y;
    if (Math.abs(dx) + Math.abs(dy) > 2) dragMoved = true;
    camX += dx * upp; camY += dy * upp;
    autoFit = false;
    cancelAnimationFrame(animFrame);
    applyCamera();
  });
  const endPointer = (e: PointerEvent) => { pointers.delete(e.pointerId); if (pointers.size < 2) pinchDist = 0; if (!pointers.size) svg.classList.remove('dragging'); };
  svg.addEventListener('pointerup', endPointer);
  svg.addEventListener('pointercancel', endPointer);
  svg.addEventListener('pointerleave', endPointer);

  function zoomAt(clientX: number, clientY: number, factor: number) {
    const rect = svg.getBoundingClientRect();
    const mx = (clientX - rect.left) * (VW / rect.width);
    const my = (clientY - rect.top) * (VH / rect.height);
    const nk = Math.max(k0 * 0.5, Math.min(k0 * 12, camK * factor));
    const f = nk / camK;
    camX = mx * (1 - f) + camX * f;
    camY = my * (1 - f) + camY * f;
    camK = nk;
    autoFit = false;
    cancelAnimationFrame(animFrame);
    applyCamera();
  }
  svg.addEventListener('wheel', (e) => {
    e.preventDefault();
    const dy = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaMode === 2 ? e.deltaY * 400 : e.deltaY;
    zoomAt(e.clientX, e.clientY, Math.max(0.75, Math.min(1.33, Math.exp(-dy * 0.0018))));
  }, { passive: false });
  const centerZoom = (f: number) => { const r = svg.getBoundingClientRect(); zoomAt(r.left + r.width / 2, r.top + r.height / 2, f); };
  document.getElementById('zoom-in')!.addEventListener('click', () => centerZoom(1.3));
  document.getElementById('zoom-out')!.addEventListener('click', () => centerZoom(1 / 1.3));
  document.getElementById('zoom-reset')!.addEventListener('click', flyHome);

  // ---- hover: highlight + card. Never moves the camera. ----
  function clearHot() {
    for (const el of conceptEls.values()) el.g.classList.remove('hot', 'dim');
    for (const el of pageEls.values()) el.g.classList.remove('hot', 'dim');
    for (const e of shareEls) e.vis.classList.remove('hot', 'dim');
    for (const e of lineageEls) e.path.classList.remove('hot', 'dim');
    for (const { circle } of ringEls.values()) circle.classList.remove('hot');
    nodeCard.hidden = true;
  }
  const showCard = (html: string) => { nodeCard.hidden = false; nodeCard.innerHTML = html; };
  const KIND_LABEL: Record<string, string> = { word: 'Loop Tongue word', idea: 'Concept', figure: 'Standing Third' };

  for (const r of data.rings) {
    const { circle } = ringEls.get(r.id)!;
    circle.addEventListener('pointerenter', () => {
      circle.classList.add('hot');
      const n = concepts.filter((c) => c.ring === r.id).length;
      showCard(`<div class="nc-part">A scale · ${n} concept${n === 1 ? '' : 's'}</div><div class="nc-title">${r.label}</div>`);
    });
    circle.addEventListener('pointerleave', clearHot);
    circle.addEventListener('click', () => { if (!dragMoved) flyToRing(r.id); });
  }
  for (const c of concepts) {
    const { g } = conceptEls.get(c.id)!;
    g.addEventListener('pointerenter', () => {
      g.classList.add('hot');
      const linked = new Set([c.id]);
      for (const e of shareEls) {
        const hot = e.a === c.id || e.b === c.id;
        e.vis.classList.toggle('hot', hot); e.vis.classList.toggle('dim', !hot);
        if (hot) { linked.add(e.a); linked.add(e.b); }
      }
      for (const e of lineageEls) {
        const hot = e.from === c.id || e.to === c.id;
        e.path.classList.toggle('hot', hot); e.path.classList.toggle('dim', !hot);
        if (hot) { linked.add(e.from); linked.add(e.to); }
      }
      if (camK / k0 >= 1.6) for (const [cid, el] of conceptEls) el.g.classList.toggle('dim', !linked.has(cid));
      showCard(`<div class="nc-part">${KIND_LABEL[c.conceptKind] ?? 'Concept'} · ${ringMeta.get(c.ring)?.label} · on ${c.appearsOn.length} page${c.appearsOn.length === 1 ? '' : 's'}</div><div class="nc-title">${c.title}</div><div class="nc-sub">${c.blurb}</div>`);
    });
    g.addEventListener('pointerleave', clearHot);
    g.addEventListener('click', (e) => {
      if (dragMoved) { e.preventDefault(); return; }
      if (camK / k0 < 2.0) { e.preventDefault(); flyToRing(c.ring); }
    });
  }
  for (const p of pages) {
    const { g } = pageEls.get(p.id)!;
    g.addEventListener('pointerenter', () => {
      g.classList.add('hot');
      showCard(`<div class="nc-part">Chapter · holds ${p.concepts.length} concept${p.concepts.length === 1 ? '' : 's'}</div><div class="nc-title">${p.title}</div><div class="nc-sub">${p.summary}</div>`);
    });
    g.addEventListener('pointerleave', clearHot);
  }
  for (const e of shareEls) {
    e.hit.addEventListener('pointerenter', () => {
      e.vis.classList.add('hot');
      const a = conceptById.get(e.a)!, b = conceptById.get(e.b)!;
      conceptEls.get(e.a)!.g.classList.add('hot'); conceptEls.get(e.b)!.g.classList.add('hot');
      showCard(`<div class="nc-part">Shares pages</div><div class="nc-title">${a.title} ↔ ${b.title}</div>`);
    });
    e.hit.addEventListener('pointerleave', clearHot);
  }
  for (const e of lineageEls) {
    e.path.addEventListener('pointerenter', () => {
      e.path.classList.add('hot');
      const a = conceptById.get(e.from)!, b = conceptById.get(e.to)!;
      conceptEls.get(e.from)!.g.classList.add('hot'); conceptEls.get(e.to)!.g.classList.add('hot');
      showCard(`<div class="nc-part">${e.kind === 'fusion' ? 'Fuses into' : 'Grows into'}</div><div class="nc-title">${a.title} → ${b.title}</div>`);
    });
    e.path.addEventListener('pointerleave', clearHot);
    e.path.style.pointerEvents = 'stroke';
  }

  applyCamera();
</script>
