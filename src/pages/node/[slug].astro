---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NextCards from '../../components/NextCards.astro';
import HeroFractal from '../../components/HeroFractal.astro';
import { PARTS } from '../../../scripts/manifest.mjs';

// Animated hero family per part, with topic-specific overrides.
const FAMILY: Record<string, string> = {
  'front': 'koch',
  'part-one': 'sierpinski',
  'part-two': 'grove',
  'part-three': 'loops',
  'part-four': 'ferns',
  'part-five': 'spirals',
  'part-six': 'rings',
  'appendix': 'koch',
};
const OVERRIDES: Record<string, string> = {
  'reading-your-own-cycle': 'tide',   // the tides paragraph is the chapter's payoff
  'closing-the-loop': 'tide',         // "a rising tide rather than a ledger"
  'the-mathematics': 'chaos',
  'the-fold': 'rings',
  'going-to-ground': 'ferns',
  'the-compost-heap': 'ferns',
  'the-skein': 'loops',
  'where-it-comes-from': 'spirals',
};

export async function getStaticPaths() {
  const nodes = await getCollection('nodes');
  return nodes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const part = PARTS[entry.data.part];
const nodes = await getCollection('nodes');
const inOrder = nodes.sort((a, b) => a.data.order - b.data.order);
const idx = inOrder.findIndex((n) => n.id === entry.id);
const nextInPart = idx >= 0 && idx < inOrder.length - 1 ? inOrder[idx + 1] : null;
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article>
    <HeroFractal
      type={(OVERRIDES[entry.id] ?? FAMILY[entry.data.part] ?? 'grove') as any}
      seed={entry.id}
      color={part?.color ?? 'var(--accent)'}
    />
    <p class="eyebrow" style={`color: ${part?.color ?? 'var(--muted)'}`}>{part?.title ?? entry.data.part}</p>
    <h1 style="margin-top: 0.2em;">{entry.data.title}</h1>
    {entry.data.epigraph && <p class="epigraph">“{entry.data.epigraph}”</p>}
    <div class="prose">
      <Content />
    </div>
  </article>

  <NextCards related={entry.data.related} nextInPart={nextInPart} />
</Base>
