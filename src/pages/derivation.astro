---
import Base from '../layouts/Base.astro';
import data from '../data/derivation.json';

// Written by scripts/reconcile.mjs from source/Derivation_Map.json and the manuscript.
const { system, alphabet, axioms, derivedMoves, rules, ground, guides, applications, traces, untraced, parkedNodes, parked, report } = data;

const groundName = Object.fromEntries([...ground.claims, ...ground.standpoint].map((a) => [a.id, a.name]));
const guideName = Object.fromEntries(guides.map((m) => [m.id, m.name]));
const moveName = Object.fromEntries([...axioms, ...derivedMoves].map((a) => [a.id, a.name]));
const nameOf: Record<string, string> = { ...groundName, ...guideName };
const traceTitle = Object.fromEntries(traces.map((t) => [t.node, t.title]));
const partLabel = (p: string | null) =>
  !p ? '' : p === 'front' ? 'Front Matter' : p.replace(/(^|-)(\w)/g, (_, d, c) => (d ? ' ' : '') + c.toUpperCase());
const say = (mv: string) => {
  const [m, s] = mv.split('@');
  return `${moveName[m]} (${s})`;
};

const kinds: [string, string, string][] = [
  ['practice', 'Theorems: the practices', 'Each chapter that tells you what to do, with the moves it is made of.'],
  ['foundation', 'Chapters that state the ground', 'Where the manuscript says what the moves stand on.'],
  ['alphabet', 'Chapters that define the alphabet', 'The words and marks everything else is written in.'],
  ['interpretation', 'Interpretations', 'Chapters that argue the system fits something: stories, mathematics, psychology, society.'],
];
const kindOf = (v: string) => (['derived', 'partial', 'orphan'].includes(v) ? 'practice' : v);
const practices = traces.filter((t) => kindOf(t.verdict) === 'practice');
const untracedByPart = [...new Set(untraced.map((n) => n.part))].map(
  (p) => [partLabel(p), untraced.filter((n) => n.part === p)] as const,
);
const attention = [
  ...report.stale.map((s) => `${s}: the chapter is gone`),
  ...report.drifted.map((s) => `${traceTitle[s] ?? s}: an anchor phrase is no longer in the text`),
  ...report.changed.map((s) => `${traceTitle[s] ?? s}: the text has changed since its trace was accepted`),
  ...report.lostApplications.map((s) => `${s}: no longer in the text under that name`),
  ...report.thinAxioms.map((s) => `${moveName[s]}: sourced from fewer than three books`),
  ...report.thinGround.map((s) => `${groundName[s]}: sourced from fewer than three books`),
  ...report.unstated.map((s) => `${moveName[s] ?? groundName[s]}: not found where the map says it is stated`),
  ...report.unusedAxioms.map((s) => `${moveName[s]}: no practice uses it`),
  ...report.errors,
];
const links = (ids: string[], names: Record<string, string>) =>
  ids.map((id, i) => ({ id, name: names[id], sep: i > 0 ? ', ' : '' }));
---
<Base title="Derivation" description="Fractalism laid out as a formal system: four moves, three rules, and every practice traced to the moves it is made of.">
  <p class="eyebrow">Derivation · {data.status}</p>
  <h1 style="margin-top: 0.2em;">What everything is derived from</h1>
  <p class="intro">
    Fractalism is a formal system of one thing: <strong>{system.of.replace(/\.$/, '').toLowerCase()}</strong>.
    Its axioms are moves, and its theorems are practices built from them.
  </p>
  <p class="intro">
    This page is a map, not a reading order. It records what comes from what, and it is checked
    against the manuscript every time the site is built.
  </p>

  <ul class="tally">
    <li><strong>{axioms.length}</strong> moves</li>
    <li><strong>{rules.length}</strong> rules</li>
    <li><strong>{practices.length}</strong> practices traced</li>
    <li><strong>{report.verdicts.partial + report.verdicts.orphan}</strong> not fully accounted for</li>
    {report.untraced > 0 && <li><strong>{report.untraced}</strong> chapters still to trace</li>}
  </ul>

  <section class="group">
    <h2>Axioms: the four moves</h2>
    <p class="note">Everything that can be done to a pattern: read it, start one, strengthen one, weaken one.</p>
    <ol class="cards">
      {axioms.map((a) => (
        <li id={a.id}>
          <h3>{a.name}</h3>
          <p>{a.statement}</p>
          <p class="meta">
            Used in {a.nodes.length} of {practices.length} practices
            ({alphabet.scales.filter((s) => a.byScale[s] > 0).map((s) => `${a.byScale[s]} at ${s}`).join(', ')})
          </p>
          <p class="meta">Stands on: {links(a.onGround, groundName).map((l) => (<>{l.sep}<a href={`#${l.id}`}>{l.name}</a></>))}</p>
          <details>
            <summary>{a.sources.length} passages from {a.books} books</summary>
            <ul class="sources">{a.sources.map((s) => (<li><em>{s.book}</em>: {s.says}</li>))}</ul>
          </details>
        </li>
      ))}
    </ol>
    {derivedMoves.map((d) => (
      <>
        <h3 class="level">The first theorem</h3>
        <ul class="cards">
          <li id={d.id}>
            <h3>{d.name}</h3>
            <p>{d.statement}</p>
            <p class="meta">Made of: {d.from.map((f, i) => (<>{i > 0 && ' and '}<a href={`#${f}`}>{moveName[f]}</a></>))}. {d.note}</p>
            <p class="meta">Two readings: {d.readings}</p>
            <p class="meta">
              Used in {d.nodes.length} of {practices.length} practices
              ({alphabet.scales.filter((s) => d.byScale[s] > 0).map((s) => `${d.byScale[s]} at ${s}`).join(', ')})
            </p>
          </li>
        </ul>
      </>
    ))}
  </section>

  <section class="group">
    <h2>Moves applied to named patterns</h2>
    <p class="note">{alphabet.lexicon.note}</p>
    <p class="note">The Turnings are {applications.length} worked cases: each one is a single move applied to a single named pattern at its own scale.</p>
    <table class="grid">
      <thead><tr><th></th>{alphabet.scales.map((s) => (<th>{s}</th>))}<th>all</th></tr></thead>
      <tbody>
        {axioms.map((a) => (
          <tr>
            <th>{a.name}</th>
            {alphabet.scales.map((s) => (<td>{a.applied[s]}</td>))}
            <td>{Object.values(a.applied).reduce((x, y) => x + y, 0)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {alphabet.scales.map((s) => (
      <details>
        <summary>At {s} scale ({applications.filter((x) => x.scale === s).length})</summary>
        <ul class="plain">
          {applications.filter((x) => x.scale === s).map((x) => (<li><strong>{moveName[x.move]}</strong> {x.figure}: {x.turning}</li>))}
        </ul>
      </details>
    ))}
  </section>

  <section class="group">
    <h2>Rules: how a move becomes another</h2>
    <ul class="cards">
      {rules.map((r) => (
        <li>
          <h3>{r.name}</h3>
          <p>{r.statement}</p>
          <p class="meta">Stands on: <a href={`#${r.ground}`}>{groundName[r.ground]}</a></p>
        </li>
      ))}
    </ul>
  </section>

  <section class="group">
    <h2>The ground the moves stand on</h2>
    <p class="note">{ground.note}</p>
    <p class="note">
      One operation runs through it: <strong>{ground.operation.replace(/\.$/, '').toLowerCase()}</strong>.
      The same operation at every scale; the forms it makes need not repeat.
    </p>
    <ol class="cards">
      {ground.claims.map((a) => (
        <li id={a.id}>
          <h3>{a.name} {a.pillar && <span class="tag">{a.pillar}</span>}{a.kind === 'value' && <span class="tag">value</span>}</h3>
          <p>{a.statement}</p>
          {a.foundations.length > 0 && (
            <p class="meta">Stated in: {links(a.foundations, traceTitle).map((l) => (<>{l.sep}<a href={`/node/${l.id}/`}>{l.name}</a></>))}</p>
          )}
          {a.note && <p class="meta">{a.note}</p>}
          <details>
            <summary>{a.sources.length} passages from {a.books} books</summary>
            <ul class="sources">
              {a.sources.map((s) => (<li><em>{s.book}</em>: {s.says}</li>))}
              {(a.tensions ?? []).map((s) => (<li class="tension"><em>{s.book}</em> pulls the other way: {s.says}</li>))}
            </ul>
          </details>
        </li>
      ))}
    </ol>

    <h3 class="level">{ground.standpointName}</h3>
    <p class="note">
      What the three pillars make unavoidable for anyone standing inside them. The pillars are true with nobody there;
      these two are not. One is your reach and one is your view.
    </p>
    <ul class="cards">
      {ground.standpoint.map((t) => (
        <li id={t.id}>
          <h3>{t.name}</h3>
          <p><strong>{t.faces}</strong> {t.statement}</p>
          <p class="meta">Why it follows: {t.derivation}</p>
          {t.foundations.length > 0 && (
            <p class="meta">Stated in: {links(t.foundations, traceTitle).map((l) => (<>{l.sep}<a href={`/node/${l.id}/`}>{l.name}</a></>))}</p>
          )}
          {t.note && <p class="meta">{t.note}</p>}
        </li>
      ))}
    </ul>

    <h3 class="level">What the pillars leave open</h3>
    <p class="note">{ground.open.note}</p>

    <h3 class="level">Direction</h3>
    <p class="note">
      Tending: {ground.poles.tending.toLowerCase()} Fraying: {ground.poles.fraying.toLowerCase()} {ground.poles.note}
    </p>
  </section>

  <section class="group">
    <h2>Guides</h2>
    <p class="note">Advice about which move to make, and where. Not axioms. Each names its own blind spot.</p>
    <ul class="cards">
      {guides.map((m) => (
        <li id={m.id}>
          <h3>{m.name}</h3>
          <p>{m.instruction}</p>
          <p class="meta">Blind spot: {m.blindSpot}</p>
          <p class="meta">From: {links(m.from, groundName).map((l) => (<>{l.sep}<a href={`#${l.id}`}>{l.name}</a></>))}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="group">
    <h2>The chapters, traced</h2>
    {kinds.map(([kind, label, note]) => (
      <>
        <h3 class="level">{label}</h3>
        <p class="note">{note}</p>
        <ul class="traces">
          {traces.filter((t) => kindOf(t.verdict) === kind).map((t) => (
            <li>
              <a href={t.href}>{t.title}</a>
              {kind === 'practice' && t.verdict !== 'derived' && <span class:list={['tag', t.verdict]}>{t.verdict}</span>}
              {(t.moves ?? []).length > 0 && <span class="from">{(t.moves ?? []).map(say).join(' · ')}</span>}
              {(t.states ?? []).length > 0 && (
                <span class="from">States: {links(t.states ?? [], groundName).map((l) => (<>{l.sep}<a href={`#${l.id}`}>{l.name}</a></>))}</span>
              )}
              {t.leftover && <span class="leftover">Left over: {t.leftover}</span>}
            </li>
          ))}
        </ul>
      </>
    ))}
  </section>

  <section class="group">
    <h2>Not yet traced</h2>
    <p class="note">
      {report.untraced === 0 ? 'Every chapter that can be traced has been.' : `${report.untraced} chapters have no trace yet.`}
      {parkedNodes.length > 0 && ` ${parkedNodes.length} are set aside. ${parked.reason}`}
    </p>
    {parkedNodes.length > 0 && (
      <details>
        <summary>Set aside ({parkedNodes.length})</summary>
        <ul class="plain">{parkedNodes.map((n) => (<li><a href={n.href}>{n.title}</a></li>))}</ul>
      </details>
    )}
    {untracedByPart.map(([label, list]) => (
      <details>
        <summary>{label} ({list.length})</summary>
        <ul class="plain">{list.map((n) => (<li><a href={n.href}>{n.title}</a></li>))}</ul>
      </details>
    ))}
  </section>

  <section class="group">
    <h2>Where the map and the manuscript disagree</h2>
    {attention.length === 0
      ? <p class="note">Nowhere. Every trace points at a chapter that exists and still says what the trace relies on.</p>
      : <ul class="plain">{attention.map((a) => (<li>{a}</li>))}</ul>}
  </section>
</Base>

<style>
  .intro { color: var(--muted); max-width: 38em; }
  .intro strong, .note strong { color: var(--ink); }
  .tally { list-style: none; padding: 0; margin: 1.6rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.6rem; font-family: var(--sans); font-size: 0.9rem; color: var(--muted); }
  .tally strong { color: var(--ink); font-size: 1.15rem; }
  .group { margin-top: 2.8rem; }
  .group > h2 { font-size: 1.15rem; margin: 0 0 0.4rem; }
  .note { color: var(--muted); font-size: 0.92rem; margin: 0 0 1rem; max-width: 38em; }
  .level { font-family: var(--sans); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin: 1.8rem 0 0.6rem; }
  .cards { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.8rem; }
  .cards > li { border: 1px solid var(--line); border-radius: 6px; padding: 0.9rem 1rem; background: var(--bg2); scroll-margin-top: 5rem; }
  .cards > li:target { border-color: var(--accent); }
  .cards h3 { font-size: 1.02rem; margin: 0 0 0.25rem; }
  .cards p { margin: 0; line-height: 1.5; }
  .meta { color: var(--muted); font-size: 0.86rem; margin-top: 0.35rem !important; }
  .tag { font-family: var(--sans); font-size: 0.68rem; font-weight: 500; letter-spacing: 0.04em; color: var(--muted); border: 1px solid var(--line); border-radius: 99px; padding: 0.05rem 0.5rem; margin-left: 0.35rem; white-space: nowrap; vertical-align: middle; }
  .tag.partial { color: var(--gold); border-color: var(--gold); }
  .tag.orphan { color: var(--c-p7); border-color: var(--c-p7); }
  details { margin-top: 0.55rem; }
  summary { cursor: pointer; font-family: var(--sans); font-size: 0.82rem; color: var(--muted); }
  .sources, .plain { margin: 0.5rem 0 0; padding-left: 1.1rem; font-size: 0.88rem; line-height: 1.5; color: var(--muted); display: grid; gap: 0.3rem; }
  .sources em { color: var(--ink); }
  .tension { color: var(--gold); }
  .grid { border-collapse: collapse; font-family: var(--sans); font-size: 0.86rem; margin: 0 0 0.6rem; }
  .grid th, .grid td { padding: 0.3rem 0.9rem 0.3rem 0; text-align: right; border-bottom: 1px solid var(--line); }
  .grid th:first-child { text-align: left; }
  .grid thead th { color: var(--muted); font-weight: 500; text-transform: capitalize; }
  .plain strong { color: var(--ink); font-weight: 600; }
  .traces { list-style: none; padding: 0; margin: 0; }
  .traces li { padding: 0.6rem 0; border-top: 1px solid var(--line); display: grid; gap: 0.15rem; }
  .traces li > a { font-weight: 600; text-decoration: none; }
  .traces li > a:hover { text-decoration: underline; }
  .traces .tag { justify-self: start; margin-left: 0; }
  .from, .leftover { font-size: 0.88rem; color: var(--muted); }
  .leftover { color: var(--gold); }
</style>
