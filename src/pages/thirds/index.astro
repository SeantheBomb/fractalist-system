---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Glyph from '../../components/Glyph.astro';
import HeroFractal from '../../components/HeroFractal.astro';
import { KINSHIPS } from '../../../scripts/manifest.mjs';

const thirds = (await getCollection('thirds')).sort((a, b) => a.data.order - b.data.order);
const order = ['self', 'dyad', 'skein', 'culture', 'cosmos'];
const groups = order.map((k) => ({
  key: k,
  meta: KINSHIPS[k],
  items: thirds.filter((t) => t.data.kinship === k),
}));
---
<Base title="The Standing Thirds" description="Patterns that recur reliably enough to be worth naming, each with two poles and each drawn as its own fractal." wide>
  <HeroFractal type="spirals" seed="standing-thirds" color="var(--c-p5)" />
  <h1>The Standing Thirds</h1>
  <p style="max-width: 44rem; color: var(--muted);">
    A pattern you can name is easier to catch than one you can only describe, and a pattern with
    a face is easier to name than one with a definition. Each figure here recurs reliably enough,
    across enough lives, to be worth naming, and <strong>none of them has intentions.</strong>
    Every one passes the same four tests: a Local Rule generates it, it's a Third Thing, it has
    two poles with neither one good or evil, and there is somewhere to push. The five kinships
    aren't ranks. Each figure sits at the scale of what it's made of: Self, Dyad, Skein, Culture,
    or Cosmos.
    <a href="/node/what-a-third-is/">The full framing is here.</a>
  </p>

  {groups.map((g) => (
    <section class="kinship">
      <div class="kinship-head">
        <h2>{g.meta.title}</h2>
        <span class="badge">{g.meta.ring}</span>
      </div>
      <p class="kinship-intro">{g.meta.intro}</p>
      <div class:list={['third-grid', { solo: g.key === 'cosmos' }]}>
        {g.items.map((t) => (
          <a class="third-card" href={`/thirds/${t.id}/`}>
            <Glyph slug={t.id} label={`${t.data.name} glyph`} />
            <div class="tc-name">{t.data.name}</div>
            {t.data.epithet && <div class="tc-epithet">{t.data.epithet}</div>}
            <div class="tc-line">{t.data.blurb}</div>
            {t.data.parents.length > 0 && <div class="tc-fusion">{t.data.personifies}</div>}
            {t.data.drawable === false && <div class="tc-never">Never drawn in a Weaving</div>}
          </a>
        ))}
      </div>
    </section>
  ))}

  <p style="margin-top: 3.5rem; color: var(--muted);">
    The roster was never meant to be complete. <a href="/node/catalogue-limits/">What This Catalogue Is Not</a>
    explains how a new pattern earns its place — and when a Weaving puts these
    figures to work, <a href="/weaving/">that happens here</a>.
  </p>
</Base>

<style>
  .kinship { margin-top: 3.5rem; }
  .kinship-head { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .kinship-head h2 { margin: 0; }
  .kinship-intro { color: var(--muted); font-size: 0.95rem; max-width: 44rem; }
  .third-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
    margin-top: 1.2rem;
  }
  .third-card {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.1rem;
    text-decoration: none;
    color: var(--ink);
    background: var(--bg2);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .third-card:hover { border-color: var(--accent); transform: translateY(-3px); }
  .tc-name { font-size: 1.25rem; font-weight: 600; margin-top: 0.6rem; }
  .tc-fusion { color: var(--muted); font-size: 0.78rem; font-family: var(--sans); margin-top: 0.5rem; }
  .tc-epithet { font-style: italic; color: var(--muted); font-size: 0.88rem; margin-bottom: 0.5rem; }
  .tc-line { font-family: var(--sans); font-size: 0.76rem; color: var(--muted); line-height: 1.45; }
  .tc-never {
    font-family: var(--sans); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--k-cosmos); margin-top: 0.6rem;
  }
  .third-grid.solo { grid-template-columns: minmax(200px, 320px); }
</style>
